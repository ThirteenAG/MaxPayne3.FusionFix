sampler2D AdapLumSampler : register(s1);
sampler2D BloomSampler : register(s10);
sampler2D BlurSampler : register(s7);
float2 BrightnessSetting : register(c135);
float BurnoutLimit : register(c147);
float4 ColorCorrectBottomOffset : register(c44);
float4 ColorCorrectTopAndPedReflectScale : register(c43);
float4 ColorFringeParams1 : register(c189);
float4 ColorFringeParams2 : register(c190);
sampler2D DOFSampler : register(s9);
sampler2D DeathSampler : register(s15);
float2 Exposures : register(c142);
sampler2D HDRPointSampler : register(s6);
float4 ImageFXParams : register(c153);
sampler2D RadialBlurSampler : register(s14);
float4 ToneMapParams : register(c144);
float ZoomBlurMaskSize : register(c154);
float blurIntensity : register(c203);
float4 deSatContrastGamma : register(c46);
float4 deSatContrastGammaIFX : register(c75);
float deathIntensity : register(c204);
float4 dofProj : register(c136);
float4 globalScreenSize : register(c41);
row_major float4x4 motionBlurMatrix : register(c157);
float radialBlurScale : register(c199);
float2 radialBlurTextureStep : register(c202);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float2 texcoord1 : TEXCOORD1;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	r0 = tex2D(HDRPointSampler, i.texcoord.xy);
	r1.xyz = float3(-1, 0, 1);
	r0.w = r1.x + radialBlurScale.x;
	r2.xy = radialBlurTextureStep.xy + i.texcoord.xy;
	r2 = tex2D(RadialBlurSampler, r2.xy);
	r2.xyz = r0.xyz * radialBlurScale.xxx + r2.xyz;
	r0.xyz = (-abs(r0.www) >= 0) ? r0.xyz : r2.xyz;
	if (blurIntensity.x != -blurIntensity.x) {
		r2 = tex2D(BlurSampler, i.texcoord.xy);
		r3.xyz = lerp(r0.xyz, r2.xyz, blurIntensity.xxx);
		r0.xyz = r3.xyz;
	}
	r2 = tex2D(DeathSampler, i.texcoord1.xy);
	r2.xyz = (-deathIntensity.xxx >= 0) ? r2.xzw : r1.yyy;
	r0.w = saturate(r2.z * ZoomBlurMaskSize.x);
	r0.w = -r0.w + 1;
	r1.y = r0.w * ImageFXParams.z;
	r0.w = ImageFXParams.z * r0.w + r1.x;
	r3.z = motionBlurMatrix[3].z;
	r1.x = -r3.z * dofProj.z;
	r1.x = 1 / r1.x;
	r3.x = r1.x * motionBlurMatrix[3].x;
	r1.x = r3.z * dofProj.w;
	r1.x = 1 / r1.x;
	r3.y = r1.x * motionBlurMatrix[3].y;
	r1.xw = i.texcoord.xy * 2 + -1;
	r3.xy = -r1.xw + r3.xy;
	r3.xy = r3.xy * ImageFXParams.yy;
	r3.xy = r3.xy * 0.125;
	r3.xy = r1.yy * -r3.xy + r3.xy;
	r3.zw = r3.xy + i.texcoord.xy;
	r4 = tex2D(DOFSampler, r3.zw);
	r4.xyz = r0.xyz + r4.xyz;
	r3.zw = r3.xy * 2 + i.texcoord.xy;
	r5 = tex2D(DOFSampler, r3.zw);
	r4.xyz = r4.xyz + r5.xyz;
	r5 = r3.xyxy * float4(3, 3, 4, 4) + i.texcoord.xyxy;
	r6 = tex2D(DOFSampler, r5.xy);
	r4.xyz = r4.xyz + r6.xyz;
	r5 = tex2D(DOFSampler, r5.zw);
	r4.xyz = r4.xyz + r5.xyz;
	r5 = r3.xyxy * float4(5, 5, 6, 6) + i.texcoord.xyxy;
	r6 = tex2D(DOFSampler, r5.xy);
	r4.xyz = r4.xyz + r6.xyz;
	r5 = tex2D(DOFSampler, r5.zw);
	r4.xyz = r4.xyz + r5.xyz;
	r3.xy = r3.xy * 7 + i.texcoord.xy;
	r3 = tex2D(DOFSampler, r3.xy);
	r3.xyz = r3.xyz + r4.xyz;
	r3.xyz = r3.xyz * 0.125;
	r0.xyz = (r0.www >= 0) ? r0.xyz : r3.xyz;
	r0.w = 1 / globalScreenSize.x;
	r3.xy = ColorFringeParams1.ww * -r0.ww + i.texcoord.xy;
	r0.w = -r2.z + 1;
	r4.xyz = r0.www * ColorFringeParams1.xyz;
	r3 = tex2D(HDRPointSampler, r3.xy);
	r5.xyz = lerp(r0.xyz, r3.xyz, r4.xyz);
	r2.w = ColorFringeParams2.w;
	r2.zw = r2.ww * -globalScreenSize.zz + i.texcoord.xy;
	r3.xyz = r0.www * ColorFringeParams2.xyz;
	r4 = tex2D(HDRPointSampler, r2.zw);
	r0.xyz = -r0.xyz + r4.xyz;
	r0.xyz = r0.xyz * r3.xyz + r5.xyz;
	r3 = tex2D(AdapLumSampler, 0);
	r0.w = r3.x + 1E-06;
	r0.w = 1 / r0.w;
	r0.w = r0.w * ToneMapParams.y;
	r3 = tex2D(BloomSampler, i.texcoord.xy);
	r1.y = lerp(ToneMapParams.z, ToneMapParams.w, r2.x);
	r3.xyz = r1.yyy * r3.xyz;
	r0.xyz = r3.xyz * 0.25 + r0.xyz;
	r3.xyz = ColorCorrectBottomOffset.xyz;
	r3.xyz = i.texcoord.yyy * r3.xyz + ColorCorrectTopAndPedReflectScale.xyz;
	r0.xyz = r0.xyz * r3.xyz;
	r1.y = lerp(Exposures.x, Exposures.y, r2.x);
	r0.xyz = r0.xyz * r1.yyy;
	r1.y = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r2.x = r0.w * r1.y;
	r2.z = BurnoutLimit.x * BurnoutLimit.x;
	r2.z = 1 / r2.z;
	r2.z = r2.x * r2.z + 1;
	r2.x = r2.z * r2.x;
	r0.w = r1.y * r0.w + 1;
	r0.w = 1 / r0.w;
	r0.w = r0.w * r2.x;
	r0.xyz = r0.www * r0.xyz;
	r0.w = saturate(dot(r0.xyz, float3(0.2125, 0.7154, 0.0721)));
	r0.w = r0.w + 1.01E-05;
	r2.z = deSatContrastGamma.z;
	r1.y = -r2.z + deSatContrastGammaIFX.z;
	r1.y = r2.y * r1.y + deSatContrastGamma.z;
	r1.y = r1.y + -0.99999;
	r2.x = pow(r0.w, r1.y);
	r0.w = min(r2.x, 65000);
	r0.xyz = r0.www * r0.xyz;
	if (deathIntensity.x != -deathIntensity.x) {
		r0.w = r1.z + -deathIntensity.x;
		r1.y = r0.w * 1.4142135;
		r2 = tex2D(DeathSampler, i.texcoord.xy);
		r1.x = dot(r1.xw, r1.xw) + -r1.y;
		r0.w = r0.w * -1.4142135 + 1.4142135;
		r0.w = 1 / r0.w;
		r0.w = saturate(r0.w * r1.x);
		r1.xyz = r0.xyz * r2.xyz + -r0.xyz;
		r0.xyz = r0.www * r1.xyz + r0.xyz;
	}
	r0.xyz = r0.xyz * BrightnessSetting.xxx + BrightnessSetting.yyy;
	r1.xyz = saturate(r0.xyz);
	o.w = dot(r1.xyz, float3(0.299, 0.587, 0.114));
	o.xyz = r0.xyz;

	return o;
}
