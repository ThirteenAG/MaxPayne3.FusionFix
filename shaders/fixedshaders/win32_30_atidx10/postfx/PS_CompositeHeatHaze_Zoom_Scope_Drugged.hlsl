sampler2D AdapLumSampler : register(s1);
sampler2D BloomSampler : register(s10);
sampler2D BlurSampler : register(s7);
float2 BrightnessSetting : register(c135);
float BurnoutLimit : register(c147);
float4 ColorCorrectBottomOffset : register(c44);
float4 ColorCorrectTopAndPedReflectScale : register(c43);
float4 ColorFringeParams1 : register(c189);
float4 ColorFringeParams2 : register(c190);
sampler2D DeathSampler : register(s15);
float4 DruggedEffectColorShift : register(c197);
float4 DruggedEffectParams : register(c198);
float2 Exposures : register(c142);
sampler2D GBufferTextureSamplerDepth : register(s3);
sampler2D HDRPointSampler : register(s6);
float4 HeatHazeOffsetParams : register(c185);
float4 HeatHazeParams : register(c182);
sampler2D HeatHazeSampler : register(s12);
float4 HeatHazeTex1Params : register(c183);
float4 HeatHazeTex2Params : register(c184);
sampler2D RadialBlurSampler : register(s14);
float4 ToneMapParams : register(c144);
float ZoomFocusDistance : register(c194);
float blurIntensity : register(c203);
float4 deSatContrastGamma : register(c46);
float4 deSatContrastGammaIFX : register(c75);
float4 dofDist : register(c137);
float dofInten : register(c138);
float4 dofProj : register(c136);
float4 globalScreenSize : register(c41);
float radialBlurScale : register(c199);
float2 radialBlurTextureStep : register(c202);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float2 texcoord1 : TEXCOORD1;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float3 r5;
	r0 = tex2D(GBufferTextureSamplerDepth, i.texcoord.xy);
	r0.y = -dofProj.x + dofProj.y;
	r0.y = 1 / r0.y;
	r0.z = r0.y * dofProj.y;
	r0.z = r0.z * -dofProj.x;
	r0.x = dofProj.y * -r0.y + r0.x;
	r0.x = 1 / r0.x;
	r0.y = r0.x * r0.z;
	r0.w = r0.z * -r0.x + ZoomFocusDistance.x;
	r0.w = saturate(r0.w * 0.2);
	r1.x = r0.z * -r0.x + dofDist.y;
	r1.y = 1 / dofDist.x;
	r1.x = saturate(r1.y * r1.x);
	r1.y = r0.z * r0.x + -dofDist.z;
	r1.z = 1 / dofDist.w;
	r1.y = saturate(r1.z * r1.y);
	r2.x = max(r1.x, r1.y);
	r1.x = r2.x * dofInten.x;
	r2.x = max(r0.w, r1.x);
	r0.x = r0.z * r0.x + -HeatHazeParams.x;
	r1.x = max(r0.x, 0);
	r0.x = 1 / HeatHazeParams.y;
	r0.x = saturate(r0.x * r1.x);
	r1.x = lerp(HeatHazeParams.z, HeatHazeParams.w, r0.x);
	r0.zw = float2(0.5, 1);
	r0.x = dofProj.y * -r0.z + r0.y;
	r1.y = max(r0.x, 0);
	r0.x = 1 / dofProj.y;
	r0.x = saturate(r0.x * r1.y);
	r0.x = -r0.x + 1;
	r0.x = r0.x * r1.x;
	r0.yz = i.texcoord.xy * HeatHazeTex1Params.xy + HeatHazeTex1Params.zw;
	r1.xy = i.texcoord.xy * HeatHazeTex2Params.xy + HeatHazeTex2Params.zw;
	r3 = tex2D(HeatHazeSampler, r0.yz);
	r1 = tex2D(HeatHazeSampler, r1.xy);
	r0.yz = r1.xy + r3.xy;
	r0.yz = r0.yz + -1;
	r0.yz = r0.yz * HeatHazeOffsetParams.xy;
	r0.xy = r0.yz * r0.xx + i.texcoord.xy;
	r1 = tex2D(HDRPointSampler, r0.xy);
	r0.x = -r0.w + radialBlurScale.x;
	r0.zw = radialBlurTextureStep.xy + i.texcoord.xy;
	r3 = tex2D(RadialBlurSampler, r0.zw);
	r2.yzw = r1.xyz * radialBlurScale.xxx + r3.xyz;
	r0.xzw = (-abs(r0.xxx) >= 0) ? r1.xyz : r2.yzw;
	if (blurIntensity.x != -blurIntensity.x) {
		r1 = tex2D(BlurSampler, i.texcoord.xy);
		r2.yzw = lerp(r0.xzw, r1.xyz, blurIntensity.xxx);
		r0.xzw = r2.yzw;
	}
	r1 = tex2D(DeathSampler, i.texcoord1.xy);
	r1.y = 1 / globalScreenSize.x;
	r2.yz = ColorFringeParams1.ww * -r1.yy + i.texcoord.xy;
	r1.y = -r1.w + 1;
	r3.xyz = r1.yyy * ColorFringeParams1.xyz;
	r4 = tex2D(HDRPointSampler, r2.yz);
	r2.yzw = lerp(r0.xzw, r4.xyz, r3.xyz);
	r1.w = ColorFringeParams2.w;
	r3.xy = r1.ww * -globalScreenSize.zz + i.texcoord.xy;
	r4.xyz = r1.yyy * ColorFringeParams2.xyz;
	r3 = tex2D(HDRPointSampler, r3.xy);
	r0.xzw = -r0.xzw + r3.xyz;
	r0.xzw = r0.xzw * r4.xyz + r2.yzw;
	r3 = tex2D(BlurSampler, i.texcoord.xy);
	r4.xyz = lerp(r0.xzw, r3.xyz, r2.xxx);
	r2 = tex2D(AdapLumSampler, 0);
	r0.x = r2.x + 1E-06;
	r0.x = 1 / r0.x;
	r0.x = r0.x * ToneMapParams.y;
	r2 = tex2D(BloomSampler, i.texcoord.xy);
	r0.z = lerp(ToneMapParams.z, ToneMapParams.w, r1.x);
	r2.xyz = r0.zzz * r2.xyz;
	r2.xyz = r2.xyz * 0.25 + r4.xyz;
	r0.w = dot(r2.xyz, 1);
	r0.w = r0.w + -1.5;
	r1.y = max(r0.w, 0);
	r0.w = 0.1;
	r0.w = r0.w + DruggedEffectParams.z;
	r3.y = r0.w * DruggedEffectParams.w;
	r0.w = -0.5 + i.texcoord.x;
	r0.w = r3.y * -r0.w;
	r1.w = r1.y + 2;
	r3.x = r0.w * r1.w;
	r3.zw = r3.xy + i.texcoord.xy;
	r4 = tex2D(BlurSampler, r3.zw);
	r3.xy = r3.xy + r3.zw;
	r3 = tex2D(BlurSampler, r3.xy);
	r0.w = dot(r4.xyz, 1);
	r0.w = r0.w + -1.5;
	r1.w = max(r0.w, 0);
	r0.w = dot(r3.xyz, 1);
	r0.w = r0.w + -1.5;
	r2.w = max(r0.w, 0);
	r0.w = r1.w + r2.w;
	r0.w = r0.w * DruggedEffectParams.z;
	r0.w = r0.w * 0.5;
	r5 = max(r4.xyz, r3.xyz);
	r3.xyz = r5.xyz * DruggedEffectColorShift.xyz;
	r3.xyz = r3.xyz * DruggedEffectParams.zzz;
	r3.xyz = r3.xyz + r3.xyz;
	r4.xyz = max(r2.xyz, r3.xyz);
	r2.x = -r1.w + r1.y;
	r1.yw = r1.yw + -r2.ww;
	r1.y = abs(r1.y) + abs(r2.x);
	r1.y = abs(r1.w) + r1.y;
	r1.y = r1.y * DruggedEffectParams.x;
	r2.x = min(r1.y, r0.w);
	r0.z = r0.z * r0.w + -r2.x;
	r1.y = min(r0.z, 1);
	r2.xyz = r1.yyy + r4.xyz;
	r3.xyz = max(r2.xyz, 0);
	r2.xyz = ColorCorrectBottomOffset.xyz;
	r0.yzw = r0.yyy * r2.xyz + ColorCorrectTopAndPedReflectScale.xyz;
	r0.yzw = r0.yzw * r3.xyz;
	r2.x = lerp(Exposures.x, Exposures.y, r1.x);
	r0.yzw = r0.yzw * r2.xxx;
	r1.x = dot(r0.yzw, float3(0.2125, 0.7154, 0.0721));
	r1.y = r0.x * r1.x;
	r1.w = BurnoutLimit.x * BurnoutLimit.x;
	r1.w = 1 / r1.w;
	r1.w = r1.y * r1.w + 1;
	r1.y = r1.w * r1.y;
	r0.x = r1.x * r0.x + 1;
	r0.x = 1 / r0.x;
	r0.x = r0.x * r1.y;
	r0.xyz = r0.xxx * r0.yzw;
	r0.w = saturate(dot(r0.xyz, float3(0.2125, 0.7154, 0.0721)));
	r0.w = r0.w + 1.01E-05;
	r2.z = deSatContrastGamma.z;
	r1.x = -r2.z + deSatContrastGammaIFX.z;
	r1.x = r1.z * r1.x + deSatContrastGamma.z;
	r1.x = r1.x + -0.99999;
	r2.x = pow(r0.w, r1.x);
	r0.w = min(r2.x, 65000);
	r0.xyz = r0.www * r0.xyz;
	r0.xyz = r0.xyz * BrightnessSetting.xxx + BrightnessSetting.yyy;
	r1.xyz = saturate(r0.xyz);
	o.w = dot(r1.xyz, float3(0.299, 0.587, 0.114));
	o.xyz = r0.xyz;

	return o;
}
