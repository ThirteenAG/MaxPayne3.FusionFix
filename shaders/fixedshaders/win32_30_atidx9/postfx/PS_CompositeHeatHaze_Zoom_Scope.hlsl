sampler2D AdapLumSampler : register(s1);
sampler2D BloomSampler : register(s10);
sampler2D BlurSampler : register(s7);
float2 BrightnessSetting : register(c130);
float BurnoutLimit : register(c142);
float4 ColorFringeParams1 : register(c182);
float4 ColorFringeParams2 : register(c183);
sampler2D DeathSampler : register(s15);
float2 Exposures : register(c137);
sampler2D GBufferTextureSamplerDepth : register(s3);
sampler2D HDRPointSampler : register(s6);
float4 HeatHazeOffsetParams : register(c178);
float4 HeatHazeParams : register(c175);
sampler2D HeatHazeSampler : register(s12);
float4 HeatHazeTex1Params : register(c176);
float4 HeatHazeTex2Params : register(c177);
sampler2D RadialBlurSampler : register(s14);
float4 ToneMapParams : register(c139);
float ZoomFocusDistance : register(c187);
float blurIntensity : register(c197);
float4 deSatContrastGamma : register(c46);
float4 deSatContrastGammaIFX : register(c75);
float deathIntensity : register(c198);
float4 dofDist : register(c133);
float dofNoBlurBlendRingSize : register(c136);
float dofNoBlurRadius : register(c135);
float4 dofProj : register(c132);
float4 globalScreenSize : register(c41);
float radialBlurScale : register(c193);
float2 radialBlurTextureStep : register(c196);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float2 texcoord1 : TEXCOORD1;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float3 r5;
	r0 = tex2D(GBufferTextureSamplerDepth, i.texcoord.xy);
	r0.y = -dofProj.x + dofProj.y;
	r0.y = 1 / r0.y;
	r0.z = r0.y * dofProj.y;
	r0.z = r0.z * -dofProj.x;
	r0.x = dofProj.y * -r0.y + r0.x;
	r0.x = 1 / r0.x;
	r0.y = r0.x * r0.z;
	r0.w = r0.z * r0.x + -HeatHazeParams.x;
	r1.x = max(r0.w, 0);
	r0.w = 1 / HeatHazeParams.y;
	r0.w = saturate(r0.w * r1.x);
	r1.x = lerp(HeatHazeParams.z, HeatHazeParams.w, r0.w);
	r1.yzw = float3(0.5, 1, -1);
	r0.y = dofProj.y * -r1.y + r0.y;
	r1.y = max(r0.y, 0);
	r0.y = 1 / dofProj.y;
	r0.y = saturate(r0.y * r1.y);
	r0.y = -r0.y + 1;
	r0.y = r0.y * r1.x;
	r1.xy = i.texcoord.xy * HeatHazeTex1Params.xy + HeatHazeTex1Params.zw;
	r2.xy = i.texcoord.xy * HeatHazeTex2Params.xy + HeatHazeTex2Params.zw;
	r3 = tex2D(HeatHazeSampler, r1.xy);
	r2 = tex2D(HeatHazeSampler, r2.xy);
	r1.xy = r2.xy + r3.xy;
	r1.xy = r1.xy + -1;
	r1.xy = r1.xy * HeatHazeOffsetParams.xy;
	r0.yw = r1.xy * r0.yy + i.texcoord.xy;
	r2 = tex2D(HDRPointSampler, r0.yw);
	r0.y = r1.w + radialBlurScale.x;
	r1.xy = radialBlurTextureStep.xy + i.texcoord.xy;
	r3 = tex2D(RadialBlurSampler, r1.xy);
	r1.xyw = r2.xyz * radialBlurScale.xxx + r3.xyz;
	r1.xyw = (-abs(r0.yyy) >= 0) ? r2.xyz : r1.xyw;
	if (blurIntensity.x != -blurIntensity.x) {
		r3 = tex2D(BlurSampler, i.texcoord.xy);
		r2.xyz = lerp(r1.xyw, r3.xyz, blurIntensity.xxx);
		r1.xyw = r2.xyz;
	}
	r3 = tex2D(DeathSampler, i.texcoord1.xy);
	r0.y = abs(deathIntensity.x);
	r2.xyz = (-r0.yyy >= 0) ? r3.xzw : 0;
	r0.y = 1 / globalScreenSize.x;
	r0.yw = ColorFringeParams1.ww * -r0.yy + i.texcoord.xy;
	r2.z = -r2.z + 1;
	r3.xyz = r2.zzz * ColorFringeParams1.xyz;
	r4 = tex2D(HDRPointSampler, r0.yw);
	r5 = lerp(r1.xyw, r4.xyz, r3.xyz);
	r0.w = ColorFringeParams2.w;
	r0.yw = r0.ww * -globalScreenSize.zz + i.texcoord.xy;
	r3.xyz = r2.zzz * ColorFringeParams2.xyz;
	r4 = tex2D(HDRPointSampler, r0.yw);
	r1.xyw = -r1.xyw + r4.xyz;
	r1.xyw = r1.xyw * r3.xyz + r5.xyz;
	if (r2.w != -r2.w) {
		r0.y = 1 / globalScreenSize.y;
		r0.y = r0.y * globalScreenSize.x;
		r0.w = r0.y * i.texcoord.x;
		r3.x = r0.w * 1.75;
		r4.x = r0.y * 0.875;
		r4.y = 0.5;
		r3.y = i.texcoord.y;
		r0.yw = r3.xy + -r4.xy;
		r0.y = dot(r0.yw, r0.yw) + 0;
		r0.y = rsqrt(r0.y);
		r0.y = 1 / r0.y;
		r3.x = dofNoBlurRadius.x;
		r0.w = r3.x + -dofNoBlurBlendRingSize.x;
		r0.w = (r0.w >= 0) ? -r0.w : -0;
		r0.y = r0.w + r0.y;
		r0.w = r0.w + dofNoBlurRadius.x;
		r0.w = 1 / r0.w;
		r0.w = saturate(r0.w * r0.y);
		r0.y = (r0.y >= 0) ? r0.w : 0;
		r0.y = (-dofNoBlurRadius.x >= 0) ? r1.z : r0.y;
		r0.w = r0.z * -r0.x + ZoomFocusDistance.x;
		r0.w = saturate(r0.w * 0.2);
		r2.z = r0.z * -r0.x + dofDist.x;
		r2.w = 1 / dofDist.x;
		r2.z = saturate(r2.w * r2.z);
		r0.x = r0.z * r0.x + -dofDist.y;
		r0.z = 1 / dofDist.w;
		r0.x = saturate(r0.z * r0.x);
		r3.x = max(r2.z, r0.x);
		r0.x = r3.x * dofDist.z;
		r2.z = max(r0.w, r0.x);
		r0.x = r0.y * r2.z;
		r3 = tex2D(BlurSampler, i.texcoord.xy);
		r4.xyz = lerp(r1.xyw, r3.xyz, r0.xxx);
		r1.xyw = r4.xyz;
	}
	r0 = tex2D(AdapLumSampler, 0);
	r0.x = r0.x + 1E-06;
	r0.x = 1 / r0.x;
	r0.x = r0.x * ToneMapParams.y;
	r3 = tex2D(BloomSampler, i.texcoord.xy);
	r0.y = lerp(ToneMapParams.z, ToneMapParams.w, r2.x);
	r0.yzw = r0.yyy * r3.xyz;
	r0.yzw = r0.yzw * 0.25 + r1.xyw;
	r1.x = lerp(Exposures.x, Exposures.y, r2.x);
	r0.yzw = r0.yzw * r1.xxx;
	r1.x = dot(r0.yzw, float3(0.2125, 0.7154, 0.0721));
	r1.y = r0.x * r1.x;
	r1.w = BurnoutLimit.x * BurnoutLimit.x;
	r1.w = 1 / r1.w;
	r1.w = r1.y * r1.w + 1;
	r1.y = r1.w * r1.y;
	r0.x = r1.x * r0.x + 1;
	r0.x = 1 / r0.x;
	r0.x = r0.x * r1.y;
	r0.xyz = r0.xxx * r0.yzw;
	r0.w = saturate(dot(r0.xyz, float3(0.2125, 0.7154, 0.0721)));
	r0.w = r0.w + 1.01E-05;
	r2.z = deSatContrastGamma.z;
	r1.x = -r2.z + deSatContrastGammaIFX.z;
	r1.x = r2.y * r1.x + deSatContrastGamma.z;
	r1.x = r1.x + -0.99999;
	r2.x = pow(r0.w, r1.x);
	r0.xyz = r0.xyz * r2.xxx;
	if (deathIntensity.x != -deathIntensity.x) {
		r0.w = r1.z + -deathIntensity.x;
		r1.x = r0.w * 1.4142135;
		r1.yz = i.texcoord.xy * 2 + -1;
		r2 = tex2D(DeathSampler, i.texcoord.xy);
		r1.x = dot(r1.yz, r1.yz) + -r1.x;
		r0.w = r0.w * -1.4142135 + 1.4142135;
		r0.w = 1 / r0.w;
		r0.w = saturate(r0.w * r1.x);
		r1.xyz = r0.xyz * r2.xyz + -r0.xyz;
		r0.xyz = r0.www * r1.xyz + r0.xyz;
	}
	r0.xyz = r0.xyz * BrightnessSetting.xxx + BrightnessSetting.yyy;
	r1.xyz = saturate(r0.xyz);
	o.w = dot(r1.xyz, float3(0.299, 0.587, 0.114));
	o.xyz = r0.xyz;

	return o;
}
