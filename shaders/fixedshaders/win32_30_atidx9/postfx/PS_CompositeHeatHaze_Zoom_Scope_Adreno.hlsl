sampler2D AdapLumSampler : register(s1);
sampler2D BloomSampler : register(s10);
sampler2D BlurSampler : register(s7);
float2 BrightnessSetting : register(c130);
float BurnoutLimit : register(c142);
float4 ColorFringeParams1 : register(c182);
float4 ColorFringeParams2 : register(c183);
sampler2D DOFSampler : register(s9);
sampler2D DeathSampler : register(s15);
float DirectionalMotionBlurLength : register(c149);
float2 Exposures : register(c137);
sampler2D GBufferTextureSamplerDepth : register(s3);
sampler2D HDRPointSampler : register(s6);
float4 HeatHazeOffsetParams : register(c178);
float4 HeatHazeParams : register(c175);
sampler2D HeatHazeSampler : register(s12);
float4 HeatHazeTex1Params : register(c176);
float4 HeatHazeTex2Params : register(c177);
sampler2D RadialBlurSampler : register(s14);
sampler2D StencilCopySampler : register(s8);
float4 ToneMapParams : register(c139);
float TotalElapsedTime : register(c189);
sampler2D VelocityBufferSampler : register(s11);
float ZoomFocusDistance : register(c187);
float blurIntensity : register(c197);
float4 deSatContrastGamma : register(c46);
float4 deSatContrastGammaIFX : register(c75);
float deathIntensity : register(c198);
float4 dofDist : register(c133);
float dofNoBlurBlendRingSize : register(c136);
float dofNoBlurRadius : register(c135);
float4 dofProj : register(c132);
float4 globalScreenSize : register(c41);
row_major float4x4 motionBlurMatrix : register(c150);
float radialBlurScale : register(c193);
float2 radialBlurTextureStep : register(c196);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float2 texcoord1 : TEXCOORD1;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	float4 r8;
	r0 = tex2D(GBufferTextureSamplerDepth, i.texcoord.xy);
	r0.y = -dofProj.x + dofProj.y;
	r0.y = 1 / r0.y;
	r0.z = r0.y * dofProj.y;
	r0.z = r0.z * -dofProj.x;
	r0.x = dofProj.y * -r0.y + r0.x;
	r0.x = 1 / r0.x;
	r0.y = r0.x * r0.z;
	r0.w = 1 / globalScreenSize.y;
	r0.w = r0.w * globalScreenSize.x;
	r1.x = r0.w * i.texcoord.x;
	r1.x = r1.x * 1.75;
	r2.x = r0.w * 0.875;
	r2.y = 0.5;
	r1.y = i.texcoord.y;
	r1.xy = r1.xy + -r2.xy;
	r0.w = dot(r1.xy, r1.xy) + 0;
	r0.w = rsqrt(r0.w);
	r0.w = 1 / r0.w;
	r1.x = dofNoBlurRadius.x;
	r1.y = r1.x + -dofNoBlurBlendRingSize.x;
	r1.y = (r1.y >= 0) ? -r1.y : -0;
	r0.w = r0.w + r1.y;
	r1.y = r1.y + dofNoBlurRadius.x;
	r1.y = 1 / r1.y;
	r1.y = saturate(r0.w * r1.y);
	r0.w = (r0.w >= 0) ? r1.y : 0;
	r0.w = (-r1.x >= 0) ? 1 : r0.w;
	r1.x = r0.z * -r0.x + ZoomFocusDistance.x;
	r1.x = saturate(r1.x * 0.2);
	r1.y = r0.z * -r0.x + dofDist.x;
	r1.z = 1 / dofDist.x;
	r1.y = saturate(r1.z * r1.y);
	r1.z = r0.z * r0.x + -dofDist.y;
	r1.w = 1 / dofDist.w;
	r1.z = saturate(r1.w * r1.z);
	r2.x = max(r1.y, r1.z);
	r1.y = r2.x * dofDist.z;
	r2.x = max(r1.x, r1.y);
	r1.x = r0.w * r2.x;
	r0.x = r0.z * r0.x + -HeatHazeParams.x;
	r1.y = max(r0.x, 0);
	r0.x = 1 / HeatHazeParams.y;
	r0.x = saturate(r0.x * r1.y);
	r1.y = lerp(HeatHazeParams.z, HeatHazeParams.w, r0.x);
	r0.z = 0.5;
	r0.x = dofProj.y * -r0.z + r0.y;
	r1.z = max(r0.x, 0);
	r0.x = 1 / dofProj.y;
	r0.x = saturate(r0.x * r1.z);
	r0.x = -r0.x + 1;
	r0.x = r0.x * r1.y;
	r1.yz = i.texcoord.xy * HeatHazeTex1Params.xy + HeatHazeTex1Params.zw;
	r2.yz = i.texcoord.xy * HeatHazeTex2Params.xy + HeatHazeTex2Params.zw;
	r3 = tex2D(HeatHazeSampler, r1.yz);
	r4 = tex2D(HeatHazeSampler, r2.yz);
	r1.yz = r3.xy + r4.xy;
	r1.yz = r1.yz + -1;
	r1.yz = r1.yz * HeatHazeOffsetParams.xy;
	r0.xz = r1.yz * r0.xx + i.texcoord.xy;
	r3 = tex2D(HDRPointSampler, r0.xz);
	r4.xzw = float3(1, -1, 2);
	r0.x = r4.z + radialBlurScale.x;
	r1.yz = radialBlurTextureStep.xy + i.texcoord.xy;
	r5 = tex2D(RadialBlurSampler, r1.yz);
	r1.yzw = r3.xyz * radialBlurScale.xxx + r5.xyz;
	r1.yzw = (-abs(r0.xxx) >= 0) ? r3.xyz : r1.yzw;
	if (blurIntensity.x != -blurIntensity.x) {
		r5 = tex2D(BlurSampler, i.texcoord.xy);
		r2.yzw = lerp(r1.yzw, r5.xyz, blurIntensity.xxx);
		r1.yzw = r2.yzw;
	}
	r5 = tex2D(DeathSampler, i.texcoord1.xy);
	r0.x = abs(deathIntensity.x);
	r2.yzw = (-r0.xxx >= 0) ? r5.xzw : 0;
	r0.xz = i.texcoord.xy * 2 + -1;
	r3.x = r0.x * dofProj.z;
	r3.y = -r0.z * dofProj.w;
	r3.xy = r0.yy * r3.xy;
	r5.xyz = r3.yyy * motionBlurMatrix[1].xyz;
	r3.xyz = r3.xxx * motionBlurMatrix[0].xyz + r5.xyz;
	r3.xyz = -r0.yyy * motionBlurMatrix[2].xyz + r3.xyz;
	r3.xyz = r3.xyz + motionBlurMatrix[3].xyz;
	r0.y = -r3.z * dofProj.z;
	r0.y = 1 / r0.y;
	r5.x = r0.y * r3.x;
	r0.y = r3.z * dofProj.w;
	r0.y = 1 / r0.y;
	r5.y = r0.y * r3.y;
	r3.xy = -r0.xz + r5.xy;
	r5 = tex2D(VelocityBufferSampler, i.texcoord.xy);
	r6 = r5.xyzz + float4(-0.5, -0.5, 0.1, 0.6);
	r4.yz = r6.xy + r6.xy;
	r5.xy = saturate(r6.xy * -2 + 0.15);
	r5.xy = r5.xy + 1;
	r4.yz = r4.yz * r5.xy;
	r7.zw = float2(12.5, 10);
	r5.xy = r7.zw * TotalElapsedTime.xx;
	r5.xy = i.texcoord.yy * float2(64, 60) + r5.xy;
	r5.xy = r5.xy * 0.15915494 + 0.5;
	r5.xy = frac(r5.xy);
	r5.xy = r5.xy * 6.2831855 + -3.1415927;
	r7.y = sin(r5.x);
	r0.y = r7.y * 0.015 + 0.05;
	r0.y = r0.y * 0.075 + 0.1;
	r5.xz = r0.yy * r4.yz;
	r3.xy = r3.xy * DirectionalMotionBlurLength.xx + r5.xz;
	r7 = r3.xyxy * 0.16666667;
	r8 = tex2D(StencilCopySampler, i.texcoord.xy);
	r0.y = -r8.w + 0.5015686;
	r0.y = (r0.y >= 0) ? 1 : 0;
	r7 = r6.zzww * r7;
	r8.y = sin(r5.y);
	r3.z = r8.y + 1;
	r5.xy = r3.zz * r7.xy;
	r5.xy = r5.xy * 0.5 + i.texcoord.xy;
	r3.z = DirectionalMotionBlurLength.x * r4.w + r5.w;
	r3.z = saturate(r3.z + 0.2);
	r6.xyw = r1.yzw;
	r4.w = 1;
	for (int i0 = 0; i0 < 5; i0++) {
		r7.xy = r7.zw * r4.ww + r5.xy;
		r8 = tex2D(DOFSampler, r7.xy);
		r6.xyw = r8.xyz * r3.zzz + r6.xyw;
		r4.w = r4.w + 1;
	}
	r3.z = r3.z * 6 + 1;
	r3.z = 1 / r3.z;
	r3.xy = r3.xy * globalScreenSize.xy;
	r3.x = dot(r3.xy, r3.xy) + 0;
	r3.x = rsqrt(r3.x);
	r3.x = 1 / r3.x;
	r3.x = r3.x * 0.5;
	r0.w = r2.x * r0.w + 1;
	r0.w = 1 / r0.w;
	r0.w = saturate(r0.w * r3.x);
	r0.w = r0.y * r0.w;
	r0.y = dot(abs(r4.yz), 0.4) + r0.y;
	r0.y = r5.w + r0.y;
	r0.y = saturate(r6.z * -2.8 + r0.y);
	r0.y = r0.y * r0.w;
	r3.xyz = r6.xyw * r3.zzz + -r1.yzw;
	r1.yzw = r0.yyy * r3.xyz + r1.yzw;
	r0.y = 1 / globalScreenSize.x;
	r0.yw = ColorFringeParams1.ww * -r0.yy + i.texcoord.xy;
	r2.x = -r2.w + 1;
	r3.xyz = r2.xxx * ColorFringeParams1.xyz;
	r5 = tex2D(HDRPointSampler, r0.yw);
	r4.yzw = lerp(r1.yzw, r5.xyz, r3.xyz);
	r3.z = globalScreenSize.z;
	r0.yw = ColorFringeParams2.ww * -r3.zz + i.texcoord.xy;
	r3.xyz = r2.xxx * ColorFringeParams2.xyz;
	r5 = tex2D(HDRPointSampler, r0.yw);
	r1.yzw = -r1.yzw + r5.xyz;
	r1.yzw = r1.yzw * r3.xyz + r4.yzw;
	if (r3.w != -r3.w) {
		r3 = tex2D(BlurSampler, i.texcoord.xy);
		r4.yzw = lerp(r1.yzw, r3.xyz, r1.xxx);
		r1.yzw = r4.yzw;
	}
	r3 = tex2D(AdapLumSampler, 0);
	r0.y = r3.x + 1E-06;
	r0.y = 1 / r0.y;
	r0.y = r0.y * ToneMapParams.y;
	r3 = tex2D(BloomSampler, i.texcoord.xy);
	r0.w = lerp(ToneMapParams.z, ToneMapParams.w, r2.y);
	r3.xyz = r0.www * r3.xyz;
	r1.xyz = r3.xyz * 0.25 + r1.yzw;
	r0.w = lerp(Exposures.x, Exposures.y, r2.y);
	r1.xyz = r0.www * r1.xyz;
	r0.w = dot(r1.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.w = r0.y * r0.w;
	r2.x = BurnoutLimit.x * BurnoutLimit.x;
	r2.x = 1 / r2.x;
	r2.x = r1.w * r2.x + 1;
	r1.w = r1.w * r2.x;
	r0.y = r0.w * r0.y + 1;
	r0.y = 1 / r0.y;
	r0.y = r0.y * r1.w;
	r1.xyz = r0.yyy * r1.xyz;
	r0.y = saturate(dot(r1.xyz, float3(0.2125, 0.7154, 0.0721)));
	r0.y = r0.y + 1.01E-05;
	r3.z = deSatContrastGamma.z;
	r0.w = -r3.z + deSatContrastGammaIFX.z;
	r0.w = r2.z * r0.w + deSatContrastGamma.z;
	r0.w = r0.w + -0.99999;
	r1.w = pow(r0.y, r0.w);
	r1.xyz = r1.www * r1.xyz;
	if (deathIntensity.x != -deathIntensity.x) {
		r0.y = r4.x + -deathIntensity.x;
		r0.w = r0.y * 1.4142135;
		r2 = tex2D(DeathSampler, i.texcoord.xy);
		r0.x = dot(r0.xz, r0.xz) + -r0.w;
		r0.y = r0.y * -1.4142135 + 1.4142135;
		r0.y = 1 / r0.y;
		r0.x = saturate(r0.y * r0.x);
		r0.yzw = r1.xyz * r2.xyz + -r1.xyz;
		r1.xyz = r0.xxx * r0.yzw + r1.xyz;
	}
	r0.xyz = r1.xyz * BrightnessSetting.xxx + BrightnessSetting.yyy;
	r1.xyz = saturate(r0.xyz);
	o.w = dot(r1.xyz, float3(0.299, 0.587, 0.114));
	o.xyz = r0.xyz;

	return o;
}
