sampler2D AdapLumSampler : register(s1);
sampler2D BloomSampler : register(s10);
sampler2D BlurSampler : register(s7);
float2 BrightnessSetting : register(c130);
float BurnoutLimit : register(c142);
sampler2D DeathSampler : register(s15);
float2 Exposures : register(c137);
sampler2D HDRPointSampler : register(s6);
float4 KillFlashCol : register(c145);
float4 KillFlashUVOff : register(c144);
sampler2D RadialBlurSampler : register(s14);
sampler2D StencilCopySampler : register(s8);
float4 ToneMapParams : register(c139);
float blurIntensity : register(c197);
float4 deSatContrastGamma : register(c46);
float4 deSatContrastGammaIFX : register(c75);
float deathIntensity : register(c198);
float radialBlurScale : register(c193);
float2 radialBlurTextureStep : register(c196);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float2 texcoord1 : TEXCOORD1;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float3 r6;
	r0 = tex2D(HDRPointSampler, i.texcoord.xy);
	r1.x = -1;
	r0.w = r1.x + radialBlurScale.x;
	r1.yz = radialBlurTextureStep.xy + i.texcoord.xy;
	r2 = tex2D(RadialBlurSampler, r1.yz);
	r1.yzw = r0.xyz * radialBlurScale.xxx + r2.xyz;
	r0.xyz = (-abs(r0.www) >= 0) ? r0.xyz : r1.yzw;
	if (blurIntensity.x != -blurIntensity.x) {
		r2 = tex2D(BlurSampler, i.texcoord.xy);
		r1.yzw = lerp(r0.xyz, r2.xyz, blurIntensity.xxx);
		r0.xyz = r1.yzw;
	}
	r2 = tex2D(DeathSampler, i.texcoord1.xy);
	r0.w = abs(deathIntensity.x);
	r1.yz = (-r0.ww >= 0) ? r2.xz : 0;
	r2 = tex2D(DeathSampler, i.texcoord.xy);
	r3.xy = KillFlashUVOff.xy + i.texcoord.xy;
	r4 = tex2D(HDRPointSampler, r3.xy);
	r3 = tex2D(StencilCopySampler, r3.xy);
	r0.w = r3.w + -0.5015686;
	r1.w = (r0.w >= 0) ? -128 : -0;
	r1.w = r3.w * 255 + r1.w;
	r2.w = r1.w + -63.9;
	r2.w = (r2.w >= 0) ? -64 : -0;
	r1.w = r1.w + r2.w;
	r2.w = r1.w + -31.9;
	r2.w = (r2.w >= 0) ? -32 : -0;
	r1.w = r1.w + r2.w;
	r2.w = r1.w + -15.9;
	r2.w = (r2.w >= 0) ? -16 : -0;
	r1.w = r1.w + r2.w;
	r2.w = r1.w + -7.9;
	r2.w = (r2.w >= 0) ? -8 : -0;
	r1.w = r1.w + r2.w;
	r1.w = r1.w + -1;
	r1.w = -abs(r1.w) + 0.1;
	r1.w = (r1.w >= 0) ? 1 : 0;
	r2.w = abs(KillFlashUVOff.w);
	r3.xy = r2.ww + float2(-1, -2);
	r2.w = (r0.w >= 0) ? 0 : r1.w;
	r0.w = (r0.w >= 0) ? r1.w : 0;
	r0.w = (-abs(r3.y) >= 0) ? r0.w : r1.w;
	r0.w = (-abs(r3.x) >= 0) ? r2.w : r0.w;
	r1.w = -r0.w + 1;
	r1.w = r1.w * KillFlashCol.w;
	r0.w = r0.w * KillFlashCol.w;
	r0.w = (KillFlashUVOff.w >= 0) ? r0.w : r1.w;
	r3.xyz = -r4.xyz + 1;
	r5.yw = float2(-1, 2);
	r5.xyz = KillFlashCol.xyz * r5.www + r5.yyy;
	r3.xyz = r3.xyz * r5.xyz;
	r6 = r4.xyz * r5.xyz;
	r3.xyz = (-r5.xyz >= 0) ? r6.xyz : r3.xyz;
	r3.xyz = r3.xyz + r4.xyz;
	r0.w = saturate(r2.y * r0.w);
	r4.xyz = lerp(r0.xyz, r3.xyz, r0.www);
	r3.xyz = (-r2.yyy >= 0) ? r0.xyz : r4.xyz;
	r0.xyz = (-KillFlashCol.www >= 0) ? r0.xyz : r3.xyz;
	r3 = tex2D(AdapLumSampler, 0);
	r0.w = r3.x + 1E-06;
	r0.w = 1 / r0.w;
	r0.w = r0.w * ToneMapParams.y;
	r3 = tex2D(BloomSampler, i.texcoord.xy);
	r2.w = lerp(ToneMapParams.z, ToneMapParams.w, r1.y);
	r3.xyz = r2.www * r3.xyz;
	r0.xyz = r3.xyz * 0.25 + r0.xyz;
	r2.w = lerp(Exposures.x, Exposures.y, r1.y);
	r0.xyz = r0.xyz * r2.www;
	r1.y = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.w = r0.w * r1.y;
	r2.w = BurnoutLimit.x * BurnoutLimit.x;
	r2.w = 1 / r2.w;
	r2.w = r1.w * r2.w + 1;
	r1.w = r1.w * r2.w;
	r0.w = r1.y * r0.w + 1;
	r0.w = 1 / r0.w;
	r0.w = r0.w * r1.w;
	r0.xyz = r0.www * r0.xyz;
	r0.w = saturate(dot(r0.xyz, float3(0.2125, 0.7154, 0.0721)));
	r0.w = r0.w + 1.01E-05;
	r3.z = deSatContrastGamma.z;
	r1.y = -r3.z + deSatContrastGammaIFX.z;
	r1.y = r1.z * r1.y + deSatContrastGamma.z;
	r1.y = r1.y + -0.99999;
	r2.w = pow(r0.w, r1.y);
	r0.xyz = r0.xyz * r2.www;
	if (deathIntensity.x != -deathIntensity.x) {
		r0.w = -r1.x + -deathIntensity.x;
		r1.x = r0.w * 1.4142135;
		r1.yz = i.texcoord.xy * 2 + -1;
		r1.x = dot(r1.yz, r1.yz) + -r1.x;
		r0.w = r0.w * -1.4142135 + 1.4142135;
		r0.w = 1 / r0.w;
		r0.w = saturate(r0.w * r1.x);
		r1.xyz = r0.xyz * r2.xyz + -r0.xyz;
		r0.xyz = r0.www * r1.xyz + r0.xyz;
	}
	r0.xyz = r0.xyz * BrightnessSetting.xxx + BrightnessSetting.yyy;
	r1.xyz = saturate(r0.xyz);
	o.w = dot(r1.xyz, float3(0.299, 0.587, 0.114));
	o.xyz = r0.xyz;

	return o;
}
