	r0.x = -r6.w + 0.5015686;
	r0.x = (r0.x >= 0) ? 1 : 0;
	r5 = r4.zzww * r5;
	r6.y = sin(r4.y);
	r3.z = r6.y + 1;
	r4.xy = r3.zz * r5.xy;
