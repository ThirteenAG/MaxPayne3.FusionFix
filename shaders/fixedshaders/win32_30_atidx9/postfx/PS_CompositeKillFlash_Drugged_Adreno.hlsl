	r4 = tex2D(HDRPointSampler, r2.yw);
	r5 = tex2D(StencilCopySampler, r2.yw);
	r0.w = r5.w + -0.5015686;
	r2.y = (r0.w >= 0) ? -128 : -0;
	r2.y = r5.w * 255 + r2.y;
	r2.w = r2.y + -63.9;
	r2.w = (r2.w >= 0) ? -64 : -0;
	r2.y = r2.w + r2.y;
	r2.w = r2.y + -31.9;
	r2.w = (r2.w >= 0) ? -32 : -0;
	r2.y = r2.w + r2.y;
	r2.w = r2.y + -15.9;
	r2.w = (r2.w >= 0) ? -16 : -0;
	r2.y = r2.w + r2.y;
	r2.w = r2.y + -7.9;
	r2.w = (r2.w >= 0) ? -8 : -0;
	r2.y = r2.w + r2.y;
	r2.y = r2.y + -1;
	r2.y = -abs(r2.y) + 0.1;
	r2.y = (r2.y >= 0) ? 1 : 0;
	r2.w = abs(KillFlashUVOff.w);
	r5.xy = r2.ww + float2(-1, -2);
	r2.w = (r0.w >= 0) ? 0 : r2.y;
	r0.w = (r0.w >= 0) ? r2.y : 0;
	r0.w = (-abs(r5.y) >= 0) ? r0.w : r2.y;
	r0.w = (-abs(r5.x) >= 0) ? r2.w : r0.w;
	r2.y = -r0.w + 1;
	r2.y = r2.y * KillFlashCol.w;
	r0.w = r0.w * KillFlashCol.w;
	r0.w = (KillFlashUVOff.w >= 0) ? r0.w : r2.y;
	r5.xyz = -r4.xyz + 1;
	r2.yzw = KillFlashCol.xyz * r2.zzz + r2.xxx;
	r5.xyz = r2.yzw * r5.xyz;
	r6.xyz = r2.yzw * r4.xyz;
	r2.yzw = (-r2.yzw >= 0) ? r6.xyz : r5.xyz;
	r2.yzw = r2.yzw + r4.xyz;
	r0.w = saturate(r3.y * r0.w);
	r4.xyz = lerp(r0.xyz, r2.yzw, r0.www);
	r2.yzw = (-r3.yyy >= 0) ? r0.xyz : r4.xyz;
	r0.xyz = (-KillFlashCol.www >= 0) ? r0.xyz : r2.yzw;
	r4 = tex2D(AdapLumSampler, 0);
	r0.w = r4.x + 1E-06;
	r0.w = 1 / r0.w;
	r0.w = r0.w * ToneMapParams.y;
	r4 = tex2D(BloomSampler, i.texcoord.xy);
	r2.y = lerp(ToneMapParams.z, ToneMapParams.w, r1.x);
	r4.xyz = r2.yyy * r4.xyz;
	r0.xyz = r4.xyz * 0.25 + r0.xyz;
	r2.z = dot(r0.xyz, 1);
	r2.z = r2.z + -1.5;
	r3.w = max(r2.z, 0);
	r4.y = 0.1;
	r2.z = r4.y + DruggedEffectParams.z;
	r4.y = r2.z * DruggedEffectParams.w;
	r2.z = -0.5 + i.texcoord.x;
	r2.z = r4.y * -r2.z;
	r2.w = r3.w + 2;
	r4.x = r2.w * r2.z;
	r2.zw = r4.xy + i.texcoord.xy;
	r5 = tex2D(BlurSampler, r2.zw);
	r2.zw = r4.xy + r2.zw;
	r4 = tex2D(BlurSampler, r2.zw);
	r2.z = dot(r5.xyz, 1);
	r2.z = r2.z + -1.5;
	r4.w = max(r2.z, 0);
	r2.z = dot(r4.xyz, 1);
	r2.z = r2.z + -1.5;
	r5.w = max(r2.z, 0);
	r2.z = r4.w + r5.w;
	r2.z = r2.z * DruggedEffectParams.z;
	r2.z = r2.z * 0.5;
	r6.xyz = max(r5.xyz, r4.xyz);
	r4.xyz = r6.xyz * DruggedEffectColorShift.xyz;
	r4.xyz = r4.xyz * DruggedEffectParams.zzz;
	r4.xyz = r4.xyz + r4.xyz;
	r5.xyz = max(r0.xyz, r4.xyz);
	r0.x = r3.w + -r4.w;
	r0.y = r3.w + -r5.w;
	r0.x = abs(r0.y) + abs(r0.x);
	r0.y = r4.w + -r5.w;
	r0.x = abs(r0.y) + r0.x;
	r0.x = r0.x * DruggedEffectParams.x;
	r3.w = min(r0.x, r2.z);
	r0.x = r2.y * r2.z + -r3.w;
	r2.y = min(r0.x, 1);
	r0.xyz = r2.yyy + r5.xyz;
	r2.y = lerp(Exposures.x, Exposures.y, r1.x);
	r2.yzw = r0.xyz * r2.yyy;
	r0.xyz = (r0.xyz >= 0) ? r2.yzw : 0;
	r1.x = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r2.y = r0.w * r1.x;
	r2.z = BurnoutLimit.x * BurnoutLimit.x;
	r2.z = 1 / r2.z;
	r2.z = r2.y * r2.z + 1;
	r2.y = r2.z * r2.y;
	r0.w = r1.x * r0.w + 1;
	r0.w = 1 / r0.w;
	r0.w = r0.w * r2.y;
	r0.xyz = r0.www * r0.xyz;
	r0.w = saturate(dot(r0.xyz, float3(0.2125, 0.7154, 0.0721)));
	r0.w = r0.w + 1.01E-05;
	r2.z = deSatContrastGamma.z;
	r1.x = -r2.z + deSatContrastGammaIFX.z;
	r1.x = r1.y * r1.x + deSatContrastGamma.z;
	r1.x = r1.x + -0.99999;
	r2.y = pow(r0.w, r1.x);
	r0.xyz = r0.xyz * r2.yyy;
	if (deathIntensity.x != -deathIntensity.x) {
		r0.w = -r2.x + -deathIntensity.x;
		r1.x = r0.w * 1.4142135;
		r1.x = dot(r1.zw, r1.zw) + -r1.x;
		r0.w = r0.w * -1.4142135 + 1.4142135;
		r0.w = 1 / r0.w;
		r0.w = saturate(r0.w * r1.x);
