	r3.xy = r4.xy + r4.xy;
	r4.xy = saturate(r4.xy * -2 + 0.15);
	r4.xy = r4.xy + 1;
	r3.xy = r3.xy * r4.xy;
	r4.xy = float2(12.5, 10);
	r4.xy = r4.xy * TotalElapsedTime.xx;
