	r2.y = 1 / r2.y;
	r2.y = saturate(r2.y * 0.5);
	r2.y = r0.x * r2.y;
	r0.x = dot(abs(r3.xy), 0.4) + r0.x;
	r0.x = r3.w + r0.x;
	r0.x = saturate(r4.z * -2.8 + r0.x);
	r0.x = r0.x * r2.y;
	r3.xyz = r6.xyz * r3.zzz + -r0.yzw;
	r0.xyz = r0.xxx * r3.xyz + r0.yzw;
	r3 = tex2D(DeathSampler, i.texcoord.xy);
