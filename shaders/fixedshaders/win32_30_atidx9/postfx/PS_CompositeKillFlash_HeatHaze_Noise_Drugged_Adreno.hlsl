	r2.z = r1.w + -63.9;
	r2.z = (r2.z >= 0) ? -64 : -0;
	r1.w = r1.w + r2.z;
	r2.z = r1.w + -31.9;
	r2.z = (r2.z >= 0) ? -32 : -0;
	r1.w = r1.w + r2.z;
	r2.z = r1.w + -15.9;
	r2.z = (r2.z >= 0) ? -16 : -0;
	r1.w = r1.w + r2.z;
	r2.z = r1.w + -7.9;
	r2.z = (r2.z >= 0) ? -8 : -0;
	r1.w = r1.w + r2.z;
	r1.w = r1.w + -1;
	r1.w = -abs(r1.w) + 0.1;
	r1.w = (r1.w >= 0) ? 1 : 0;
	r2.z = abs(KillFlashUVOff.w);
	r2.zw = r2.zz + float2(-1, -2);
	r3.w = (r0.w >= 0) ? 0 : r1.w;
	r0.w = (r0.w >= 0) ? r1.w : 0;
	r0.w = (-abs(r2.w) >= 0) ? r0.w : r1.w;
	r0.w = (-abs(r2.z) >= 0) ? r3.w : r0.w;
	r1.w = -r0.w + 1;
	r1.w = r1.w * KillFlashCol.w;
	r0.w = r0.w * KillFlashCol.w;
