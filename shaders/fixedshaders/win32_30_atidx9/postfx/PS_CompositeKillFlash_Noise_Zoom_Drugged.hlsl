sampler2D AdapLumSampler : register(s1);
sampler2D BloomSampler : register(s10);
sampler2D BlurSampler : register(s7);
float2 BrightnessSetting : register(c130);
float BurnoutLimit : register(c142);
sampler2D DeathSampler : register(s15);
float4 DruggedEffectColorShift : register(c191);
float4 DruggedEffectParams : register(c192);
float2 Exposures : register(c137);
sampler2D GBufferTextureSamplerDepth : register(s3);
sampler2D HDRPointSampler : register(s6);
float4 KillFlashCol : register(c145);
float4 KillFlashUVOff : register(c144);
float4 NoiseParams : register(c143);
sampler2D RadialBlurSampler : register(s14);
sampler2D StencilCopySampler : register(s8);
float4 ToneMapParams : register(c139);
float ZoomFocusDistance : register(c187);
float blurIntensity : register(c197);
float4 deSatContrastGamma : register(c46);
float4 deSatContrastGammaIFX : register(c75);
float deathIntensity : register(c198);
float4 dofDist : register(c133);
float dofNoBlurBlendRingSize : register(c136);
float dofNoBlurRadius : register(c135);
float4 dofProj : register(c132);
float4 globalScreenSize : register(c41);
float radialBlurScale : register(c193);
float2 radialBlurTextureStep : register(c196);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float2 texcoord1 : TEXCOORD1;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float3 r6;
	r0 = tex2D(HDRPointSampler, i.texcoord.xy);
	r1.x = -1;
	r1.y = r1.x + radialBlurScale.x;
	r1.zw = radialBlurTextureStep.xy + i.texcoord.xy;
	r2 = tex2D(RadialBlurSampler, r1.zw);
	r2.xyz = r0.xyz * radialBlurScale.xxx + r2.xyz;
	r0.xyz = (-abs(r1.yyy) >= 0) ? r0.xyz : r2.xyz;
	if (blurIntensity.x != -blurIntensity.x) {
		r2 = tex2D(BlurSampler, i.texcoord.xy);
		r1.yzw = lerp(r0.xyz, r2.xyz, blurIntensity.xxx);
		r0.xyz = r1.yzw;
	}
	r2 = tex2D(DeathSampler, i.texcoord1.xy);
	r1.y = abs(deathIntensity.x);
	r1.yz = (-r1.yy >= 0) ? r2.xz : 0;
	if (r0.w != -r0.w) {
		r2 = tex2D(GBufferTextureSamplerDepth, i.texcoord.xy);
		r0.w = -dofProj.x + dofProj.y;
		r0.w = 1 / r0.w;
		r1.w = r0.w * dofProj.y;
		r1.w = r1.w * -dofProj.x;
		r0.w = dofProj.y * -r0.w + r2.x;
		r0.w = 1 / r0.w;
		r2.x = 1 / globalScreenSize.y;
		r2.x = r2.x * globalScreenSize.x;
		r2.y = r2.x * i.texcoord.x;
		r3.x = r2.y * 1.75;
		r2.x = r2.x * 0.875;
		r2.y = 0.5;
		r3.y = i.texcoord.y;
		r2.xy = -r2.xy + r3.xy;
		r2.x = dot(r2.xy, r2.xy) + 0;
		r2.x = rsqrt(r2.x);
		r2.x = 1 / r2.x;
		r3.x = dofNoBlurRadius.x;
		r2.y = r3.x + -dofNoBlurBlendRingSize.x;
		r2.y = (r2.y >= 0) ? -r2.y : -0;
		r2.x = r2.y + r2.x;
		r2.y = r2.y + dofNoBlurRadius.x;
		r2.y = 1 / r2.y;
		r2.y = saturate(r2.y * r2.x);
		r2.x = (r2.x >= 0) ? r2.y : 0;
		r2.x = (-dofNoBlurRadius.x >= 0) ? -r1.x : r2.x;
		r2.y = r1.w * -r0.w + ZoomFocusDistance.x;
		r2.y = saturate(r2.y * 0.2);
		r2.z = r1.w * -r0.w + dofDist.x;
		r2.w = 1 / dofDist.x;
		r2.z = saturate(r2.w * r2.z);
		r0.w = r1.w * r0.w + -dofDist.y;
		r1.w = 1 / dofDist.w;
		r0.w = saturate(r0.w * r1.w);
		r1.w = max(r2.z, r0.w);
		r0.w = r1.w * dofDist.z;
		r1.w = max(r2.y, r0.w);
		r0.w = r2.x * r1.w;
		r2 = tex2D(BlurSampler, i.texcoord.xy);
		r3.xyz = lerp(r0.xyz, r2.xyz, r0.www);
		r0.xyz = r3.xyz;
	}
	r2 = tex2D(DeathSampler, i.texcoord.xy);
	r3.xy = KillFlashUVOff.xy + i.texcoord.xy;
	r4 = tex2D(HDRPointSampler, r3.xy);
	r3 = tex2D(StencilCopySampler, r3.xy);
	r0.w = r3.w + -0.5015686;
	r1.w = (r0.w >= 0) ? -128 : -0;
	r1.w = r3.w * 255 + r1.w;
	r2.w = r1.w + -63.9;
	r2.w = (r2.w >= 0) ? -64 : -0;
	r1.w = r1.w + r2.w;
	r2.w = r1.w + -31.9;
	r2.w = (r2.w >= 0) ? -32 : -0;
	r1.w = r1.w + r2.w;
	r2.w = r1.w + -15.9;
	r2.w = (r2.w >= 0) ? -16 : -0;
	r1.w = r1.w + r2.w;
	r2.w = r1.w + -7.9;
	r2.w = (r2.w >= 0) ? -8 : -0;
	r1.w = r1.w + r2.w;
	r1.w = r1.w + -1;
	r1.w = -abs(r1.w) + 0.1;
	r1.w = (r1.w >= 0) ? 1 : 0;
	r2.w = abs(KillFlashUVOff.w);
	r3.xy = r2.ww + float2(-1, -2);
	r2.w = (r0.w >= 0) ? 0 : r1.w;
	r0.w = (r0.w >= 0) ? r1.w : 0;
	r0.w = (-abs(r3.y) >= 0) ? r0.w : r1.w;
	r0.w = (-abs(r3.x) >= 0) ? r2.w : r0.w;
	r1.w = -r0.w + 1;
	r1.w = r1.w * KillFlashCol.w;
	r0.w = r0.w * KillFlashCol.w;
	r0.w = (KillFlashUVOff.w >= 0) ? r0.w : r1.w;
	r3.xyz = -r4.xyz + 1;
	r5.xyw = float3(0.1, -1, 2);
	r5.yzw = KillFlashCol.xyz * r5.www + r5.yyy;
	r3.xyz = r3.xyz * r5.yzw;
	r6 = r4.xyz * r5.yzw;
	r3.xyz = (-r5.yzw >= 0) ? r6.xyz : r3.xyz;
	r3.xyz = r3.xyz + r4.xyz;
	r0.w = saturate(r2.y * r0.w);
	r4.xyz = lerp(r0.xyz, r3.xyz, r0.www);
	r3.xyz = (-r2.yyy >= 0) ? r0.xyz : r4.xyz;
	r0.xyz = (-KillFlashCol.www >= 0) ? r0.xyz : r3.xyz;
	r3.xy = float2(3.2, 1.8);
	r3.xy = i.texcoord.xy * r3.xy + NoiseParams.xy;
	r3.xy = frac(r3.xy);
	r3 = tex2D(BlurSampler, r3.xy);
	r0.w = r3.z + -0.5;
	r0.xyz = r0.www * NoiseParams.zzz + r0.xyz;
	r3.xyz = max(r0.xyz, 0);
	r0 = tex2D(AdapLumSampler, 0);
	r0.x = r0.x + 1E-06;
	r0.x = 1 / r0.x;
	r0.x = r0.x * ToneMapParams.y;
	r4 = tex2D(BloomSampler, i.texcoord.xy);
	r0.y = lerp(ToneMapParams.z, ToneMapParams.w, r1.y);
	r4.xyz = r0.yyy * r4.xyz;
	r3.xyz = r4.xyz * 0.25 + r3.xyz;
	r0.z = dot(r3.xyz, 1);
	r0.z = r0.z + -1.5;
	r1.w = max(r0.z, 0);
	r0.z = r5.x + DruggedEffectParams.z;
	r4.y = r0.z * DruggedEffectParams.w;
	r0.z = -0.5 + i.texcoord.x;
	r0.z = r4.y * -r0.z;
	r0.w = r1.w + 2;
	r4.x = r0.w * r0.z;
	r0.zw = r4.xy + i.texcoord.xy;
	r5 = tex2D(BlurSampler, r0.zw);
	r0.zw = r4.xy + r0.zw;
	r4 = tex2D(BlurSampler, r0.zw);
	r0.z = dot(r5.xyz, 1);
	r0.z = r0.z + -1.5;
	r2.w = max(r0.z, 0);
	r0.z = dot(r4.xyz, 1);
	r0.z = r0.z + -1.5;
	r3.w = max(r0.z, 0);
	r0.z = r2.w + r3.w;
	r0.z = r0.z * DruggedEffectParams.z;
	r0.z = r0.z * 0.5;
	r6 = max(r5.xyz, r4.xyz);
	r4.xyz = r6.xyz * DruggedEffectColorShift.xyz;
	r4.xyz = r4.xyz * DruggedEffectParams.zzz;
	r4.xyz = r4.xyz + r4.xyz;
	r5.xyz = max(r3.xyz, r4.xyz);
	r0.w = r1.w + -r2.w;
	r1.w = r1.w + -r3.w;
	r0.w = abs(r0.w) + abs(r1.w);
	r1.w = r2.w + -r3.w;
	r0.w = r0.w + abs(r1.w);
	r0.w = r0.w * DruggedEffectParams.x;
	r1.w = min(r0.w, r0.z);
	r0.y = r0.y * r0.z + -r1.w;
	r1.w = min(r0.y, 1);
	r0.yzw = r1.www + r5.xyz;
	r2.w = lerp(Exposures.x, Exposures.y, r1.y);
	r3.xyz = r0.yzw * r2.www;
	r0.yzw = (r0.yzw >= 0) ? r3.xyz : 0;
	r1.y = dot(r0.yzw, float3(0.2125, 0.7154, 0.0721));
	r1.w = r0.x * r1.y;
	r2.w = BurnoutLimit.x * BurnoutLimit.x;
	r2.w = 1 / r2.w;
	r2.w = r1.w * r2.w + 1;
	r1.w = r1.w * r2.w;
	r0.x = r1.y * r0.x + 1;
	r0.x = 1 / r0.x;
	r0.x = r0.x * r1.w;
	r0.xyz = r0.xxx * r0.yzw;
	r0.w = saturate(dot(r0.xyz, float3(0.2125, 0.7154, 0.0721)));
	r0.w = r0.w + 1.01E-05;
	r3.z = deSatContrastGamma.z;
	r1.y = -r3.z + deSatContrastGammaIFX.z;
	r1.y = r1.z * r1.y + deSatContrastGamma.z;
	r1.y = r1.y + -0.99999;
	r2.w = pow(r0.w, r1.y);
	r0.xyz = r0.xyz * r2.www;
	if (deathIntensity.x != -deathIntensity.x) {
		r0.w = -r1.x + -deathIntensity.x;
		r1.x = r0.w * 1.4142135;
		r1.yz = i.texcoord.xy * 2 + -1;
		r1.x = dot(r1.yz, r1.yz) + -r1.x;
		r0.w = r0.w * -1.4142135 + 1.4142135;
		r0.w = 1 / r0.w;
		r0.w = saturate(r0.w * r1.x);
		r1.xyz = r0.xyz * r2.xyz + -r0.xyz;
		r0.xyz = r0.www * r1.xyz + r0.xyz;
	}
	r0.xyz = r0.xyz * BrightnessSetting.xxx + BrightnessSetting.yyy;
	r1.xyz = saturate(r0.xyz);
	o.w = dot(r1.xyz, float3(0.299, 0.587, 0.114));
	o.xyz = r0.xyz;

	return o;
}
