sampler2D AdapLumSampler : register(s1);
sampler2D BloomSampler : register(s10);
sampler2D BlurSampler : register(s7);
float2 BrightnessSetting : register(c130);
float BurnoutLimit : register(c142);
float4 ColorFringeParams1 : register(c182);
float4 ColorFringeParams2 : register(c183);
sampler2D DOFSampler : register(s9);
sampler2D DeathSampler : register(s15);
float DirectionalMotionBlurLength : register(c149);
float4 DruggedEffectColorShift : register(c191);
float4 DruggedEffectParams : register(c192);
float2 Exposures : register(c137);
sampler2D GBufferTextureSamplerDepth : register(s3);
sampler2D HDRPointSampler : register(s6);
sampler2D RadialBlurSampler : register(s14);
sampler2D StencilCopySampler : register(s8);
float4 ToneMapParams : register(c139);
float TotalElapsedTime : register(c189);
sampler2D VelocityBufferSampler : register(s11);
float blurIntensity : register(c197);
float4 deSatContrastGamma : register(c46);
float4 deSatContrastGammaIFX : register(c75);
float deathIntensity : register(c198);
float4 dofProj : register(c132);
float4 globalScreenSize : register(c41);
row_major float4x4 motionBlurMatrix : register(c150);
float radialBlurScale : register(c193);
float2 radialBlurTextureStep : register(c196);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float2 texcoord1 : TEXCOORD1;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	r0 = tex2D(GBufferTextureSamplerDepth, i.texcoord.xy);
	r0.y = -dofProj.x + dofProj.y;
	r0.y = 1 / r0.y;
	r0.z = r0.y * dofProj.y;
	r0.z = r0.z * -dofProj.x;
	r0.x = dofProj.y * -r0.y + r0.x;
	r0.x = 1 / r0.x;
	r0.x = r0.x * r0.z;
	r1 = tex2D(HDRPointSampler, i.texcoord.xy);
	r2.xz = float2(-1, 2);
	r0.y = r2.x + radialBlurScale.x;
	r0.zw = radialBlurTextureStep.xy + i.texcoord.xy;
	r3 = tex2D(RadialBlurSampler, r0.zw);
	r3.xyz = r1.xyz * radialBlurScale.xxx + r3.xyz;
	r0.yzw = (-abs(r0.yyy) >= 0) ? r1.xyz : r3.xyz;
	if (blurIntensity.x != -blurIntensity.x) {
		r1 = tex2D(BlurSampler, i.texcoord.xy);
		r3.xyz = lerp(r0.yzw, r1.xyz, blurIntensity.xxx);
		r0.yzw = r3.xyz;
	}
	r1 = tex2D(DeathSampler, i.texcoord1.xy);
	r1.y = abs(deathIntensity.x);
	r1.xyz = (-r1.yyy >= 0) ? r1.xzw : 0;
	r2.yw = i.texcoord.xy * 2 + -1;
	r1.w = r2.y * dofProj.z;
	r1.w = r0.x * r1.w;
	r3.x = -r2.w * dofProj.w;
	r3.x = r0.x * r3.x;
	r3.xyz = r3.xxx * motionBlurMatrix[1].xyz;
	r3.xyz = r1.www * motionBlurMatrix[0].xyz + r3.xyz;
	r3.xyz = -r0.xxx * motionBlurMatrix[2].xyz + r3.xyz;
	r3.xyz = r3.xyz + motionBlurMatrix[3].xyz;
	r0.x = -r3.z * dofProj.z;
	r0.x = 1 / r0.x;
	r4.x = r0.x * r3.x;
	r0.x = r3.z * dofProj.w;
	r0.x = 1 / r0.x;
	r4.y = r0.x * r3.y;
	r3.xy = -r2.yw + r4.xy;
	r4 = tex2D(VelocityBufferSampler, i.texcoord.xy);
	r5 = r4.xyzz + float4(-0.5, -0.5, 0.1, 0.6);
	r3.zw = r5.xy + r5.xy;
	r4.xy = saturate(r5.xy * -2 + 0.15);
	r4.xy = r4.xy + 1;
	r3.zw = r3.zw * r4.xy;
	r4.xy = float2(12.5, 10);
	r4.xy = r4.xy * TotalElapsedTime.xx;
	r4.xy = i.texcoord.yy * float2(64, 60) + r4.xy;
	r4.xy = r4.xy * 0.15915494 + 0.5;
	r4.xy = frac(r4.xy);
	r4.xy = r4.xy * 6.2831855 + -3.1415927;
	r6.y = sin(r4.x);
	r0.x = r6.y * 0.015 + 0.05;
	r0.x = r0.x * 0.075 + 0.1;
	r4.xz = r0.xx * r3.zw;
	r3.xy = r3.xy * DirectionalMotionBlurLength.xx + r4.xz;
	r6 = r3.xyxy * 0.16666667;
	r7 = tex2D(StencilCopySampler, i.texcoord.xy);
	r0.x = -r7.w + 0.5015686;
	r0.x = (r0.x >= 0) ? 1 : 0;
	r6 = r5.zzww * r6;
	r7.y = sin(r4.y);
	r1.w = r7.y + 1;
	r4.xy = r1.ww * r6.xy;
	r4.xy = r4.xy * 0.5 + i.texcoord.xy;
	r1.w = DirectionalMotionBlurLength.x * r2.z + r4.w;
	r1.w = saturate(r1.w + 0.2);
	r5.xyw = r0.yzw;
	r2.z = 1;
	for (int i0 = 0; i0 < 5; i0++) {
		r6.xy = r6.zw * r2.zz + r4.xy;
		r7 = tex2D(DOFSampler, r6.xy);
		r5.xyw = r7.xyz * r1.www + r5.xyw;
		r2.z = r2.z + 1;
	}
	r1.w = r1.w * 6 + 1;
	r1.w = 1 / r1.w;
	r3.xy = r3.xy * globalScreenSize.xy;
	r2.z = dot(r3.xy, r3.xy) + 0;
	r2.z = rsqrt(r2.z);
	r2.z = 1 / r2.z;
	r2.z = saturate(r2.z * 0.5);
	r2.z = r0.x * r2.z;
	r0.x = dot(abs(r3.zw), 0.4) + r0.x;
	r0.x = r4.w + r0.x;
	r0.x = saturate(r5.z * -2.8 + r0.x);
	r0.x = r0.x * r2.z;
	r3.xyz = r5.xyw * r1.www + -r0.yzw;
	r0.xyz = r0.xxx * r3.xyz + r0.yzw;
	r0.w = 1 / globalScreenSize.x;
	r3.xy = ColorFringeParams1.ww * -r0.ww + i.texcoord.xy;
	r0.w = -r1.z + 1;
	r4.xyz = r0.www * ColorFringeParams1.xyz;
	r3 = tex2D(HDRPointSampler, r3.xy);
	r5.xyz = lerp(r0.xyz, r3.xyz, r4.xyz);
	r1.w = ColorFringeParams2.w;
	r1.zw = r1.ww * -globalScreenSize.zz + i.texcoord.xy;
	r3.xyz = r0.www * ColorFringeParams2.xyz;
	r4 = tex2D(HDRPointSampler, r1.zw);
	r0.xyz = -r0.xyz + r4.xyz;
	r0.xyz = r0.xyz * r3.xyz + r5.xyz;
	r3 = tex2D(AdapLumSampler, 0);
	r0.w = r3.x + 1E-06;
	r0.w = 1 / r0.w;
	r0.w = r0.w * ToneMapParams.y;
	r3 = tex2D(BloomSampler, i.texcoord.xy);
	r2.z = lerp(ToneMapParams.z, ToneMapParams.w, r1.x);
	r3.xyz = r2.zzz * r3.xyz;
	r0.xyz = r3.xyz * 0.25 + r0.xyz;
	r1.z = dot(r0.xyz, 1);
	r1.z = r1.z + -1.5;
	r3.x = max(r1.z, 0);
	r3.y = 0.1;
	r1.z = r3.y + DruggedEffectParams.z;
	r4.y = r1.z * DruggedEffectParams.w;
	r1.z = -0.5 + i.texcoord.x;
	r1.z = r4.y * -r1.z;
	r1.w = r3.x + 2;
	r4.x = r1.w * r1.z;
	r1.zw = r4.xy + i.texcoord.xy;
	r5 = tex2D(BlurSampler, r1.zw);
	r1.zw = r4.xy + r1.zw;
	r4 = tex2D(BlurSampler, r1.zw);
	r1.z = dot(r5.xyz, 1);
	r1.z = r1.z + -1.5;
	r3.y = max(r1.z, 0);
	r1.z = dot(r4.xyz, 1);
	r1.z = r1.z + -1.5;
	r3.z = max(r1.z, 0);
	r1.z = r3.z + r3.y;
	r1.z = r1.z * DruggedEffectParams.z;
	r1.z = r1.z * 0.5;
	r6.xyz = max(r5.xyz, r4.xyz);
	r4.xyz = r6.xyz * DruggedEffectColorShift.xyz;
	r4.xyz = r4.xyz * DruggedEffectParams.zzz;
	r4.xyz = r4.xyz + r4.xyz;
	r5.xyz = max(r0.xyz, r4.xyz);
	r0.xy = -r3.yz + r3.xx;
	r0.x = abs(r0.y) + abs(r0.x);
	r0.y = -r3.z + r3.y;
	r0.x = abs(r0.y) + r0.x;
	r0.x = r0.x * DruggedEffectParams.x;
	r3.x = min(r0.x, r1.z);
	r0.x = r2.z * r1.z + -r3.x;
	r1.z = min(r0.x, 1);
	r0.xyz = r1.zzz + r5.xyz;
	r2.z = lerp(Exposures.x, Exposures.y, r1.x);
	r1.xzw = r0.xyz * r2.zzz;
	r0.xyz = (r0.xyz >= 0) ? r1.xzw : 0;
	r1.x = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.z = r0.w * r1.x;
	r1.w = BurnoutLimit.x * BurnoutLimit.x;
	r1.w = 1 / r1.w;
	r1.w = r1.z * r1.w + 1;
	r1.z = r1.w * r1.z;
	r0.w = r1.x * r0.w + 1;
	r0.w = 1 / r0.w;
	r0.w = r0.w * r1.z;
	r0.xyz = r0.www * r0.xyz;
	r0.w = saturate(dot(r0.xyz, float3(0.2125, 0.7154, 0.0721)));
	r0.w = r0.w + 1.01E-05;
	r1.z = deSatContrastGamma.z;
	r1.x = -r1.z + deSatContrastGammaIFX.z;
	r1.x = r1.y * r1.x + deSatContrastGamma.z;
	r1.x = r1.x + -0.99999;
	r2.z = pow(r0.w, r1.x);
	r0.xyz = r0.xyz * r2.zzz;
	if (deathIntensity.x != -deathIntensity.x) {
		r0.w = -r2.x + -deathIntensity.x;
		r1.x = r0.w * 1.4142135;
		r3 = tex2D(DeathSampler, i.texcoord.xy);
		r1.x = dot(r2.yw, r2.yw) + -r1.x;
		r0.w = r0.w * -1.4142135 + 1.4142135;
		r0.w = 1 / r0.w;
		r0.w = saturate(r0.w * r1.x);
		r1.xyz = r0.xyz * r3.xyz + -r0.xyz;
		r0.xyz = r0.www * r1.xyz + r0.xyz;
	}
	r0.xyz = r0.xyz * BrightnessSetting.xxx + BrightnessSetting.yyy;
	r1.xyz = saturate(r0.xyz);
	o.w = dot(r1.xyz, float3(0.299, 0.587, 0.114));
	o.xyz = r0.xyz;

	return o;
}
