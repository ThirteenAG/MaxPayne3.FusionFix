	r0.w = r0.w + r1.y;
	r1.y = r1.y + dofNoBlurRadius.x;
	r1.y = 1 / r1.y;
	r1.y = saturate(r0.w * r1.y);
	r0.w = (r0.w >= 0) ? r1.y : 0;
	r0.w = (-r1.x >= 0) ? 1 : r0.w;
	r1.x = r0.z * -r0.x + ZoomFocusDistance.x;
	r1.x = saturate(r1.x * 0.2);
	r1.y = r0.z * -r0.x + dofDist.x;
	r1.z = 1 / dofDist.x;
	r1.y = saturate(r1.z * r1.y);
	r0.x = r0.z * r0.x + -dofDist.y;
	r0.z = 1 / dofDist.w;
	r0.x = saturate(r0.z * r0.x);
	r2.x = max(r1.y, r0.x);
	r0.x = r2.x * dofDist.z;
	r2.x = max(r1.x, r0.x);
	r0.x = r0.w * r2.x;
	r1 = tex2D(HDRPointSampler, i.texcoord.xy);
	r3.xzw = float3(1, -1, 2);
	r0.z = r3.z + radialBlurScale.x;
	r2.yz = radialBlurTextureStep.xy + i.texcoord.xy;
	r4 = tex2D(RadialBlurSampler, r2.yz);
	r2.yzw = r1.xyz * radialBlurScale.xxx + r4.xyz;
	r1.xyz = (-abs(r0.zzz) >= 0) ? r1.xyz : r2.yzw;
