	r0.w = r0.w * globalScreenSize.x;
	r1.x = r0.w * i.texcoord.x;
	r1.x = r1.x * 1.75;
	r2.x = r0.w * 0.875;
	r2.y = 0.5;
	r1.y = i.texcoord.y;
	r1.xy = r1.xy + -r2.xy;
	r0.w = dot(r1.xy, r1.xy) + 0;
