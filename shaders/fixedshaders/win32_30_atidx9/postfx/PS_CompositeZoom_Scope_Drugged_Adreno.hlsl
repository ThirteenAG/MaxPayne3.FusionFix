	r4.xyz = r0.zzz * motionBlurMatrix[0].xyz + r4.xyz;
	r4.xyz = -r0.yyy * motionBlurMatrix[2].xyz + r4.xyz;
	r4.xyz = r4.xyz + motionBlurMatrix[3].xyz;
	r0.y = -r4.z * dofProj.z;
	r0.y = 1 / r0.y;
	r5.x = r0.y * r4.x;
	r0.y = r4.z * dofProj.w;
	r0.y = 1 / r0.y;
	r5.y = r0.y * r4.y;
	r0.yz = -r3.yz + r5.xy;
	r4 = tex2D(VelocityBufferSampler, i.texcoord.xy);
