	r4 = tex2D(DeathSampler, i.texcoord1.xy);
	r0.z = abs(deathIntensity.x);
	r2.yzw = (-r0.zzz >= 0) ? r4.xzw : 0;
	r3.yz = i.texcoord.xy * 2 + -1;
	r0.z = r3.y * dofProj.z;
	r0.z = r0.y * r0.z;
	r4.x = -r3.z * dofProj.w;
	r4.x = r0.y * r4.x;
