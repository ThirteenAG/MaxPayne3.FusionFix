	r3.w = r3.w * 6 + 1;
	r3.w = 1 / r3.w;
	r0.yz = r0.yz * globalScreenSize.xy;
	r0.y = dot(r0.yz, r0.yz) + 0;
	r0.y = rsqrt(r0.y);
	r0.y = 1 / r0.y;
	r0.y = r0.y * 0.5;
	r0.z = r2.x * r0.w + 1;
	r0.z = 1 / r0.z;
	r0.y = saturate(r0.z * r0.y);
	r0.y = r4.z * r0.y;
	r0.z = dot(abs(r4.xy), 0.4) + r4.z;
	r0.z = r4.w + r0.z;
	r0.z = saturate(r5.z * -2.8 + r0.z);
	r0.y = r0.z * r0.y;
	r4.xyz = r7.xyz * r3.www + -r1.xyz;
	r0.yzw = r0.yyy * r4.xyz + r1.xyz;
	r1.x = 1 / globalScreenSize.x;
	r1.xy = ColorFringeParams1.ww * -r1.xx + i.texcoord.xy;
	r1.z = -r2.w + 1;
	r4.xyz = r1.zzz * ColorFringeParams1.xyz;
	r5 = tex2D(HDRPointSampler, r1.xy);
	r6.xyz = lerp(r0.yzw, r5.xyz, r4.xyz);
	r4.z = globalScreenSize.z;
	r1.xy = ColorFringeParams2.ww * -r4.zz + i.texcoord.xy;
	r4.xyz = r1.zzz * ColorFringeParams2.xyz;
	r5 = tex2D(HDRPointSampler, r1.xy);
	r0.yzw = -r0.yzw + r5.xyz;
	r0.yzw = r0.yzw * r4.xyz + r6.xyz;
	if (r1.w != -r1.w) {
		r1 = tex2D(BlurSampler, i.texcoord.xy);
		r4.xyz = lerp(r0.yzw, r1.xyz, r0.xxx);
		r0.yzw = r4.xyz;
	}
	r1 = tex2D(AdapLumSampler, 0);
	r0.x = r1.x + 1E-06;
	r0.x = 1 / r0.x;
	r0.x = r0.x * ToneMapParams.y;
	r1 = tex2D(BloomSampler, i.texcoord.xy);
	r1.w = lerp(ToneMapParams.z, ToneMapParams.w, r2.y);
	r1.xyz = r1.www * r1.xyz;
	r0.yzw = r1.xyz * 0.25 + r0.yzw;
	r1.x = dot(r0.yzw, 1);
	r1.x = r1.x + -1.5;
	r2.x = max(r1.x, 0);
	r1.y = 0.1;
	r1.x = r1.y + DruggedEffectParams.z;
	r1.y = r1.x * DruggedEffectParams.w;
	r1.z = -0.5 + i.texcoord.x;
	r1.z = r1.y * -r1.z;
	r2.w = r2.x + 2;
	r1.x = r1.z * r2.w;
	r4.xy = r1.xy + i.texcoord.xy;
	r5 = tex2D(BlurSampler, r4.xy);
	r1.xy = r1.xy + r4.xy;
	r4 = tex2D(BlurSampler, r1.xy);
	r1.x = dot(r5.xyz, 1);
	r1.x = r1.x + -1.5;
	r2.w = max(r1.x, 0);
	r1.x = dot(r4.xyz, 1);
	r1.x = r1.x + -1.5;
	r3.w = max(r1.x, 0);
	r1.x = r2.w + r3.w;
	r1.x = r1.x * DruggedEffectParams.z;
	r1.x = r1.x * 0.5;
	r6.xyz = max(r5.xyz, r4.xyz);
	r4.xyz = r6.xyz * DruggedEffectColorShift.xyz;
	r4.xyz = r4.xyz * DruggedEffectParams.zzz;
	r4.xyz = r4.xyz + r4.xyz;
	r5.xyz = max(r0.yzw, r4.xyz);
	r0.y = -r2.w + r2.x;
	r0.z = r2.x + -r3.w;
	r0.y = abs(r0.z) + abs(r0.y);
	r0.z = r2.w + -r3.w;
	r0.y = abs(r0.z) + r0.y;
	r0.y = r0.y * DruggedEffectParams.x;
	r2.x = min(r0.y, r1.x);
	r0.y = r1.w * r1.x + -r2.x;
	r1.x = min(r0.y, 1);
	r0.yzw = r1.xxx + r5.xyz;
	r1.x = lerp(Exposures.x, Exposures.y, r2.y);
	r1.xyz = r0.yzw * r1.xxx;
	r0.yzw = (r0.yzw >= 0) ? r1.xyz : 0;
	r1.x = dot(r0.yzw, float3(0.2125, 0.7154, 0.0721));
