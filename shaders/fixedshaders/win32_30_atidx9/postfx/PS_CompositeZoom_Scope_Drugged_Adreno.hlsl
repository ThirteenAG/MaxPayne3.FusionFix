	r5.xy = saturate(r5.xy * -2 + 0.15);
	r5.xy = r5.xy + 1;
	r4.xy = r4.xy * r5.xy;
	r6.zw = float2(12.5, 10);
	r5.xy = r6.zw * TotalElapsedTime.xx;
	r5.xy = i.texcoord.yy * float2(64, 60) + r5.xy;
	r5.xy = r5.xy * 0.15915494 + 0.5;
	r5.xy = frac(r5.xy);
	r5.xy = r5.xy * 6.2831855 + -3.1415927;
	r6.y = sin(r5.x);
	r4.z = r6.y * 0.015 + 0.05;
	r4.z = r4.z * 0.075 + 0.1;
	r6.xy = r4.zz * r4.xy;
	r0.yz = r0.yz * DirectionalMotionBlurLength.xx + r6.xy;
	r6 = r0.yzyz * 0.16666667;
	r7 = tex2D(StencilCopySampler, i.texcoord.xy);
	r4.z = -r7.w + 0.5015686;
	r4.z = (r4.z >= 0) ? 1 : 0;
	r6 = r5.zzww * r6;
	r7.y = sin(r5.y);
	r5.x = r7.y + 1;
	r5.xy = r5.xx * r6.xy;
	r5.xy = r5.xy * 0.5 + i.texcoord.xy;
	r3.w = DirectionalMotionBlurLength.x * r3.w + r4.w;
	r3.w = saturate(r3.w + 0.2);
	r7.xyz = r1.xyz;
	r5.w = 1;
	for (int i0 = 0; i0 < 5; i0++) {
		r6.xy = r6.zw * r5.ww + r5.xy;
		r8 = tex2D(DOFSampler, r6.xy);
		r7.xyz = r8.xyz * r3.www + r7.xyz;
		r5.w = r5.w + 1;
