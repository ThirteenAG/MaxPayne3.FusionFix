	r1.z = BurnoutLimit.x * BurnoutLimit.x;
	r1.z = 1 / r1.z;
	r1.z = r1.y * r1.z + 1;
	r1.y = r1.z * r1.y;
	r0.x = r1.x * r0.x + 1;
	r0.x = 1 / r0.x;
	r0.x = r0.x * r1.y;
	r0.xyz = r0.xxx * r0.yzw;
	r0.w = saturate(dot(r0.xyz, float3(0.2125, 0.7154, 0.0721)));
	r0.w = r0.w + 1.01E-05;
	r1.z = deSatContrastGamma.z;
	r1.x = -r1.z + deSatContrastGammaIFX.z;
	r1.x = r2.z * r1.x + deSatContrastGamma.z;
	r1.x = r1.x + -0.99999;
	r2.x = pow(r0.w, r1.x);
	r0.xyz = r0.xyz * r2.xxx;
	if (deathIntensity.x != -deathIntensity.x) {
		r0.w = r3.x + -deathIntensity.x;
		r1.x = r0.w * 1.4142135;
		r2 = tex2D(DeathSampler, i.texcoord.xy);
		r1.x = dot(r3.yz, r3.yz) + -r1.x;
		r0.w = r0.w * -1.4142135 + 1.4142135;
		r0.w = 1 / r0.w;
		r0.w = saturate(r0.w * r1.x);
		r1.xyz = r0.xyz * r2.xyz + -r0.xyz;
