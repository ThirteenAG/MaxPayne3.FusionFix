float4 ColorCorrectBottomOffset : register(c44);
float4 ColorCorrectBottomOffsetScreenEdge : register(c67);
float4 ColorCorrectTopAndPedReflectScale : register(c43);
float4 ColorCorrectTopScreenEdge : register(c66);
float4 ColorShift : register(c45);
float ColorShiftScalar : register(c181);
sampler2D GBufferTextureSamplerDepth : register(s3);
sampler2D HDRSampler : register(s5);
float PedBrightness : register(c180);
float PlayerBrightness : register(c179);
sampler2D StencilCopySampler : register(s8);
float4 deSatContrastGamma : register(c46);
float4 dofProj : register(c132);
float4 gAdrenoFXVars : register(c68);
float4 gDepthFxParams : register(c18);
float4 globalFogColorN : register(c50);
float4 globalFogParams : register(c37);
float4 globalScalars4 : register(c51);
float4 globalScreenSize : register(c41);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float2 vpos : VPOS;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	r0.x = -dofProj.x + dofProj.y;
	r0.x = 1 / r0.x;
	r0.y = r0.x * dofProj.y;
	r0.y = r0.y * -dofProj.x;
	r1 = tex2D(GBufferTextureSamplerDepth, i.texcoord.xy);
	r0.x = dofProj.y * -r0.x + r1.x;
	r0.z = r1.x + -1;
	r0.z = (r0.z >= 0) ? 1 : 0;
	r0.x = 1 / r0.x;
	r0.x = r0.x * r0.y;
	r0.y = saturate(-r0.x * gDepthFxParams.z + gDepthFxParams.w);
	r1.xyz = -r0.xxx * i.texcoord1.xyz;
	r0.x = saturate(r0.z + r0.y);
	r0.y = -r0.x + 1;
	r0.xy = r0.yy * gDepthFxParams.xy + r0.xx;
	r2 = tex2D(HDRSampler, i.texcoord.xy);
	r0.z = dot(r2.xyz, float3(0.2125, 0.7154, 0.0721));
	r3.xyz = lerp(r0.zzz, r2.xyz, r0.xxx);
	r0.x = r0.y + -0.99999;
	r0.y = r0.z + 1E-05;
	r0.y = abs(r0.y) + 1E-05;
	r1.w = pow(r0.y, r0.x);
	r0.xyz = r3.xyz * r1.www + -globalFogColorN.xyz;
	r0.w = r1.z * globalFogParams.x;
	r1.x = dot(r1.xyz, r1.xyz);
	r1.x = rsqrt(r1.x);
	r1.x = 1 / r1.x;
	r1.x = r1.x * globalFogParams.z;
	r1.y = r0.w * -1.442695;
	r1.y = exp2(r1.y);
	r1.z = r1.y + -65504;
	r1.y = -r1.y + 1;
	r1.y = (r1.z >= 0) ? -65503 : r1.y;
	r1.z = 1 / r0.w;
	r0.w = -abs(r0.w) + 0.0001;
	r1.y = r1.z * r1.y;
	r1.y = r1.y * r1.x;
	r0.w = (r0.w >= 0) ? r1.x : r1.y;
	r0.w = r0.w * -globalFogParams.y;
	r0.w = r0.w * 1.442695;
	r0.w = saturate(exp2(r0.w));
	r0.xyz = r0.www * r0.xyz + globalFogColorN.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r1 = tex2D(StencilCopySampler, i.texcoord.xy);
	r1.x = r1.w + -0.5015686;
	r1.y = (r1.x >= 0) ? -128 : -0;
	r1.y = r1.w * 255 + r1.y;
	r1.z = r1.w * 255 + -5;
	r1.w = r1.y + -63.9;
	r2.xy = (r1.ww >= 0) ? float2(1, -64) : 0;
	r1.y = r1.y + r2.y;
	r1.w = r1.y + -31.9;
	r1.w = (r1.w >= 0) ? -32 : -0;
	r1.y = r1.w + r1.y;
	r1.w = r1.y + -15.9;
	r1.w = (r1.w >= 0) ? -16 : -0;
	r1.y = r1.w + r1.y;
	r1.w = r1.y + -7.9;
	r1.w = (r1.w >= 0) ? -8 : -0;
	r1.y = r1.w + r1.y;
	r1.y = r1.y + -1;
	r1.yz = -abs(r1.yz) + 0.1;
	r1.y = (r1.y >= 0) ? 1 : 0;
	r1.w = (r1.x >= 0) ? 0 : r1.y;
	r1.x = (r1.x >= 0) ? r1.y : 0;
	r3 = gAdrenoFXVars;
	r3 = r3.wzyx * deSatContrastGamma.x;
	r1.y = (r1.z >= 0) ? r3.z : r3.w;
	r1.y = (-r1.w >= 0) ? r1.y : r3.y;
	r1.y = (-r1.x >= 0) ? r1.y : r3.x;
	r2.yzw = lerp(r0.www, r0.xyz, r1.yyy);
	r0.x = r0.w * ColorShift.w;
	r0.y = r0.w * ColorCorrectBottomOffset.w;
	r0.z = r1.w + r1.x;
	r0.w = r2.x + r1.x;
	r1.x = 1;
	r0.z = (-r0.z >= 0) ? r1.x : ColorShiftScalar.x;
	r0.x = r0.z * r0.x;
	r1.xyz = ColorShift.xyz * -r0.xxx + r2.yzw;
	r2.xyz = globalScalars4.yzw * -r0.yyy + r2.yzw;
	r3.xyz = r0.xxx * ColorShift.xyz;
	r0.x = saturate(r0.x);
	r1.xyz = r0.xxx * r1.xyz + r3.xyz;
	r0.x = 1 / globalScreenSize.y;
	r3.y = r0.x * i.vpos.y;
	r4.xyz = ColorCorrectBottomOffset.xyz;
	r4.xyz = r3.yyy * r4.xyz + ColorCorrectTopAndPedReflectScale.xyz;
	r4.xyz = r1.xyz * r4.xyz;
	r1.xyz = r0.yyy * globalScalars4.yzw;
	r0.y = saturate(r0.y);
	r0.xyz = r0.yyy * r2.xyz + r1.xyz;
	r2 = ColorCorrectTopScreenEdge;
	r1.xyz = r3.yyy * ColorCorrectBottomOffsetScreenEdge.xyz + r2.xyz;
	r5.xyz = r0.xyz * r1.xyz;
	r0.x = 1 / globalScreenSize.x;
	r3.x = r0.x * i.vpos.x;
	r0.xy = r3.xy + -0.5;
	r0.x = dot(r0.xy, r0.xy) + 0;
	r0.x = rsqrt(r0.x);
	r0.x = 1 / r0.x;
	r0.y = r2.w + -ColorCorrectBottomOffsetScreenEdge.w;
	r0.y = (r0.y >= 0) ? -r0.y : -0;
	r0.x = r0.y + r0.x;
	r0.y = r0.y + ColorCorrectTopScreenEdge.w;
	r0.y = 1 / r0.y;
	r0.y = saturate(r0.y * r0.x);
	r0.x = (r0.x >= 0) ? r0.y : 0;
	r5.w = 1;
	r4.w = 1;
	r2 = lerp(r4, r5, r0.x);
	r2 = (ColorCorrectTopScreenEdge.w >= 0) ? r2 : r4;
	r0.xyz = r2.xyz * PedBrightness.xxx;
	r0.xyz = (-r1.www >= 0) ? r2.xyz : r0.xyz;
	r1.xyz = r2.xyz * PlayerBrightness.xxx;
	o.w = r2.w;
	o.xyz = (-r0.www >= 0) ? r0.xyz : r1.xyz;

	return o;
}
