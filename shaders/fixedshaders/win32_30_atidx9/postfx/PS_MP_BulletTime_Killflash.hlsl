sampler2D AdapLumSampler : register(s1);
sampler2D BloomSampler : register(s10);
sampler2D BlurSampler : register(s7);
float2 BrightnessSetting : register(c130);
float BurnoutLimit : register(c142);
sampler2D DOFSampler : register(s9);
sampler2D DeathSampler : register(s15);
float2 Exposures : register(c137);
sampler2D GBufferTextureSamplerDepth : register(s3);
sampler2D HDRPointSampler : register(s6);
float4 KillFlashCol : register(c145);
float4 KillFlashUVOff : register(c144);
float4 MP_BulletTimeParams : register(c155);
float4 NoiseParams : register(c143);
sampler2D RadialBlurSampler : register(s14);
sampler2D StencilCopySampler : register(s8);
float4 ToneMapParams : register(c139);
float TotalElapsedTime : register(c189);
sampler2D VelocityBufferSampler : register(s11);
float blurIntensity : register(c197);
float4 deSatContrastGamma : register(c46);
float4 deSatContrastGammaIFX : register(c75);
float deathIntensity : register(c198);
float4 dofProj : register(c132);
row_major float4x4 motionBlurMatrix : register(c150);
float radialBlurScale : register(c193);
float2 radialBlurTextureStep : register(c196);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float2 texcoord1 : TEXCOORD1;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	r0 = tex2D(GBufferTextureSamplerDepth, i.texcoord.xy);
	r0.y = -dofProj.x + dofProj.y;
	r0.y = 1 / r0.y;
	r0.z = r0.y * dofProj.y;
	r0.z = r0.z * -dofProj.x;
	r0.x = dofProj.y * -r0.y + r0.x;
	r0.x = 1 / r0.x;
	r0.x = r0.x * r0.z;
	r1 = tex2D(HDRPointSampler, i.texcoord.xy);
	r2.xw = float2(-1, 1);
	r0.y = r2.x + radialBlurScale.x;
	r0.zw = radialBlurTextureStep.xy + i.texcoord.xy;
	r3 = tex2D(RadialBlurSampler, r0.zw);
	r2.xyz = r1.xyz * radialBlurScale.xxx + r3.xyz;
	r0.yzw = (-abs(r0.yyy) >= 0) ? r1.xyz : r2.xyz;
	if (blurIntensity.x != -blurIntensity.x) {
		r1 = tex2D(BlurSampler, i.texcoord.xy);
		r2.xyz = lerp(r0.yzw, r1.xyz, blurIntensity.xxx);
		r0.yzw = r2.xyz;
	}
	r1 = tex2D(DeathSampler, i.texcoord1.xy);
	r1.y = abs(deathIntensity.x);
	r1.xy = (-r1.yy >= 0) ? r1.xz : 0;
	r3 = tex2D(StencilCopySampler, i.texcoord.xy);
	r1.z = r3.w * 255;
	r1.w = frac(r1.z);
	r1.z = r1.z + -r1.w;
	r1.w = (-r1.w >= 0) ? 0 : 1;
	r1.w = (r3.w >= 0) ? 0 : r1.w;
	r1.z = r1.w + r1.z;
	r2.xy = (r1.zz >= 0) ? float2(2, 0.5) : float2(-2, -0.5);
	r1.z = r1.z * r2.y;
	r1.z = frac(r1.z);
	r1.z = r1.z * r2.x;
	r1.w = frac(r1.z);
	r2.x = r1.z + -r1.w;
	r1.w = (-r1.w >= 0) ? 0 : 1;
	r1.z = (r1.z >= 0) ? 0 : r1.w;
	r1.z = r1.z + r2.x;
	r1.w = (-abs(r1.z) >= 0) ? 1 : 0;
	r3 = 0.5 + -i.texcoord.xyxy;
	r2.x = dot(r3.zw, r3.zw) + 0;
	r2.x = rsqrt(r2.x);
	r2.x = 1 / r2.x;
	r2.x = r2.x * MP_BulletTimeParams.w;
	r2.x = r2.x * 1.4144272;
	r2.y = r2.x * r2.x;
	r2.x = saturate(r2.x * r2.y);
	r2.yz = i.texcoord.xy * 2 + -1;
	r4.x = r2.y * dofProj.z;
	r4.y = -r2.z * dofProj.w;
	r4.xy = r0.xx * r4.xy;
	r4.yzw = r4.yyy * motionBlurMatrix[1].xyz;
	r4.xyz = r4.xxx * motionBlurMatrix[0].xyz + r4.yzw;
	r4.xyz = -r0.xxx * motionBlurMatrix[2].xyz + r4.xyz;
	r4.xyz = r4.xyz + motionBlurMatrix[3].xyz;
	r0.x = -r4.z * dofProj.z;
	r0.x = 1 / r0.x;
	r5.xz = r0.xx * r4.xx;
	r0.x = r4.z * dofProj.w;
	r0.x = 1 / r0.x;
	r5.yw = r0.xx * r4.yy;
	r4 = -r2.yzyz + r5;
	r5 = tex2D(VelocityBufferSampler, i.texcoord.xy);
	r5.xyz = r5.xyz + float3(-0.5, -0.5, 0.6);
	r6 = r5.xyxy + r5.xyxy;
	r7 = saturate(r5.xyxy * -2 + 0.15);
	r7 = r7 + 1;
	r6 = r6 * r7;
	r0.x = 64 * i.texcoord.y;
	r5.w = 12.5;
	r0.x = TotalElapsedTime.x * r5.w + r0.x;
	r0.x = r0.x * 0.15915494 + 0.5;
	r0.x = frac(r0.x);
	r0.x = r0.x * 6.2831855 + -3.1415927;
	r7.y = sin(r0.x);
	r0.x = r7.y * 0.015 + 0.05;
	r0.x = r0.x * 0.075 + 0.1;
	r6 = r0.x * r6;
	r5 = r5.z * r6;
	r0.x = dot(r5.zw, r5.zw) + 0;
	r0.x = rsqrt(r0.x);
	r0.x = 1 / r0.x;
	r0.x = saturate(r0.x * 16);
	r6 = tex2D(DOFSampler, 0.5);
	r4 = r4 * MP_BulletTimeParams.y;
	r3 = r3 * MP_BulletTimeParams.x + -r4;
	r3 = r3 * r2.x + r5;
	r3 = r1.w * r3;
	r3 = r3 * float4(0.5, 0.5, 0.75, 0.75) + i.texcoord.xyxy;
	r4 = tex2D(DOFSampler, r3.xy);
	r4.xyz = r4.xyz + r6.xyz;
	r3 = tex2D(DOFSampler, r3.zw);
	r3.xyz = r3.xyz + r4.xyz;
	r4.xyz = r3.xyz * 0.33333334 + -r0.yzw;
	r4.xyz = r0.xxx * r4.xyz + r0.yzw;
	r3.xyz = r3.xyz * 0.33333334 + -0.5;
	r1.w = r2.x * MP_BulletTimeParams.z + r2.w;
	r3.xyz = r3.xyz * r1.www + 0.5;
	r5.xyz = max(r3.xyz, 0);
	r3.xyz = min(r5.xyz, 10);
	r5.xyz = lerp(r0.yzw, r3.xyz, r2.xxx);
	r3.xyz = lerp(r5.xyz, r4.xyz, r0.xxx);
	r0.xyz = (-abs(r1.zzz) >= 0) ? r3.xyz : r0.yzw;
	r3 = tex2D(DeathSampler, i.texcoord.xy);
	r1.zw = KillFlashUVOff.xy + i.texcoord.xy;
	r4 = tex2D(HDRPointSampler, r1.zw);
	r5 = tex2D(StencilCopySampler, r1.zw);
	r0.w = r5.w + -0.5015686;
	r1.z = (r0.w >= 0) ? -128 : -0;
	r1.z = r5.w * 255 + r1.z;
	r1.w = r1.z + -63.9;
	r1.w = (r1.w >= 0) ? -64 : -0;
	r1.z = r1.w + r1.z;
	r1.w = r1.z + -31.9;
	r1.w = (r1.w >= 0) ? -32 : -0;
	r1.z = r1.w + r1.z;
	r1.w = r1.z + -15.9;
	r1.w = (r1.w >= 0) ? -16 : -0;
	r1.z = r1.w + r1.z;
	r1.w = r1.z + -7.9;
	r1.w = (r1.w >= 0) ? -8 : -0;
	r1.z = r1.w + r1.z;
	r1.z = r1.z + -1;
	r1.z = -abs(r1.z) + 0.1;
	r1.z = (r1.z >= 0) ? 1 : 0;
	r1.w = abs(KillFlashUVOff.w);
	r5.xy = r1.ww + float2(-1, -2);
	r1.w = (r0.w >= 0) ? 0 : r1.z;
	r0.w = (r0.w >= 0) ? r1.z : 0;
	r0.w = (-abs(r5.y) >= 0) ? r0.w : r1.z;
	r0.w = (-abs(r5.x) >= 0) ? r1.w : r0.w;
	r1.z = -r0.w + 1;
	r1.z = r1.z * KillFlashCol.w;
	r0.w = r0.w * KillFlashCol.w;
	r0.w = (KillFlashUVOff.w >= 0) ? r0.w : r1.z;
	r5.xyz = -r4.xyz + 1;
	r6.yz = float2(2, -1);
	r6.xyz = KillFlashCol.xyz * r6.yyy + r6.zzz;
	r5.xyz = r5.xyz * r6.xyz;
	r7.xyz = r4.xyz * r6.xyz;
	r5.xyz = (-r6.xyz >= 0) ? r7.xyz : r5.xyz;
	r4.xyz = r4.xyz + r5.xyz;
	r0.w = saturate(r3.y * r0.w);
	r5.xyz = lerp(r0.xyz, r4.xyz, r0.www);
	r4.xyz = (-r3.yyy >= 0) ? r0.xyz : r5.xyz;
	r0.xyz = (-KillFlashCol.www >= 0) ? r0.xyz : r4.xyz;
	r4.xy = float2(3.2, 1.8);
	r1.zw = i.texcoord.xy * r4.xy + NoiseParams.xy;
	r1.zw = frac(r1.zw);
	r4 = tex2D(BlurSampler, r1.zw);
	r0.w = r4.z + -0.5;
	r0.xyz = r0.www * NoiseParams.zzz + r0.xyz;
	r4.xyz = max(r0.xyz, 0);
	r0 = tex2D(AdapLumSampler, 0);
	r0.x = r0.x + 1E-06;
	r0.x = 1 / r0.x;
	r0.x = r0.x * ToneMapParams.y;
	r5 = tex2D(BloomSampler, i.texcoord.xy);
	r0.y = lerp(ToneMapParams.z, ToneMapParams.w, r1.x);
	r0.yzw = r0.yyy * r5.xyz;
	r0.yzw = r0.yzw * 0.25 + r4.xyz;
	r2.x = lerp(Exposures.x, Exposures.y, r1.x);
	r0.yzw = r0.yzw * r2.xxx;
	r1.x = dot(r0.yzw, float3(0.2125, 0.7154, 0.0721));
	r1.z = r0.x * r1.x;
	r1.w = BurnoutLimit.x * BurnoutLimit.x;
	r1.w = 1 / r1.w;
	r1.w = r1.z * r1.w + 1;
	r1.z = r1.w * r1.z;
	r0.x = r1.x * r0.x + 1;
	r0.x = 1 / r0.x;
	r0.x = r0.x * r1.z;
	r0.xyz = r0.xxx * r0.yzw;
	r0.w = saturate(dot(r0.xyz, float3(0.2125, 0.7154, 0.0721)));
	r0.w = r0.w + 1.01E-05;
	r1.z = deSatContrastGamma.z;
	r1.x = -r1.z + deSatContrastGammaIFX.z;
	r1.x = r1.y * r1.x + deSatContrastGamma.z;
	r1.x = r1.x + -0.99999;
	r2.x = pow(r0.w, r1.x);
	r0.xyz = r0.xyz * r2.xxx;
	if (deathIntensity.x != -deathIntensity.x) {
		r0.w = r2.w + -deathIntensity.x;
		r1.x = r0.w * 1.4142135;
		r1.x = dot(r2.yz, r2.yz) + -r1.x;
		r0.w = r0.w * -1.4142135 + 1.4142135;
		r0.w = 1 / r0.w;
		r0.w = saturate(r0.w * r1.x);
		r1.xyz = r0.xyz * r3.xyz + -r0.xyz;
		r0.xyz = r0.www * r1.xyz + r0.xyz;
	}
	r0.xyz = r0.xyz * BrightnessSetting.xxx + BrightnessSetting.yyy;
	r1.xyz = saturate(r0.xyz);
	o.w = dot(r1.xyz, float3(0.299, 0.587, 0.114));
	o.xyz = r0.xyz;

	return o;
}
