sampler2D AdapLumSampler : register(s1);
sampler2D BloomSampler : register(s10);
sampler2D BlurSampler : register(s7);
float2 BrightnessSetting : register(c130);
float BurnoutLimit : register(c142);
float4 ColorFringeParams1 : register(c182);
float4 ColorFringeParams2 : register(c183);
sampler2D DOFSampler : register(s9);
sampler2D DeathSampler : register(s15);
float2 Exposures : register(c137);
sampler2D GBufferTextureSamplerDepth : register(s3);
sampler2D HDRPointSampler : register(s6);
float4 ImageFXParams : register(c146);
float4 MP_BulletTimeParams : register(c155);
sampler2D RadialBlurSampler : register(s14);
sampler2D StencilCopySampler : register(s8);
float4 ToneMapParams : register(c139);
float TotalElapsedTime : register(c189);
sampler2D VelocityBufferSampler : register(s11);
float ZoomBlurMaskSize : register(c147);
float blurIntensity : register(c197);
float4 deSatContrastGamma : register(c46);
float4 deSatContrastGammaIFX : register(c75);
float deathIntensity : register(c198);
float4 dofProj : register(c132);
float4 globalScreenSize : register(c41);
row_major float4x4 motionBlurMatrix : register(c150);
float radialBlurScale : register(c193);
float2 radialBlurTextureStep : register(c196);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float2 texcoord1 : TEXCOORD1;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	float4 r8;
	r0 = tex2D(GBufferTextureSamplerDepth, i.texcoord.xy);
	r0.y = -dofProj.x + dofProj.y;
	r0.y = 1 / r0.y;
	r0.z = r0.y * dofProj.y;
	r0.z = r0.z * -dofProj.x;
	r0.x = dofProj.y * -r0.y + r0.x;
	r0.x = 1 / r0.x;
	r0.x = r0.x * r0.z;
	r1 = tex2D(HDRPointSampler, i.texcoord.xy);
	r2.xw = float2(-1, 1);
	r0.y = r2.x + radialBlurScale.x;
	r0.zw = radialBlurTextureStep.xy + i.texcoord.xy;
	r3 = tex2D(RadialBlurSampler, r0.zw);
	r3.xyz = r1.xyz * radialBlurScale.xxx + r3.xyz;
	r0.yzw = (-abs(r0.yyy) >= 0) ? r1.xyz : r3.xyz;
	if (blurIntensity.x != -blurIntensity.x) {
		r1 = tex2D(BlurSampler, i.texcoord.xy);
		r3.xyz = lerp(r0.yzw, r1.xyz, blurIntensity.xxx);
		r0.yzw = r3.xyz;
	}
	r1 = tex2D(DeathSampler, i.texcoord1.xy);
	r1.y = abs(deathIntensity.x);
	r1.xyz = (-r1.yyy >= 0) ? r1.xzw : 0;
	r3 = tex2D(StencilCopySampler, i.texcoord.xy);
	r1.w = r3.w * 255;
	r2.y = frac(r1.w);
	r1.w = r1.w + -r2.y;
	r2.y = (-r2.y >= 0) ? 0 : 1;
	r2.y = (r3.w >= 0) ? 0 : r2.y;
	r1.w = r1.w + r2.y;
	r2.yz = (r1.ww >= 0) ? float2(2, 0.5) : float2(-2, -0.5);
	r1.w = r1.w * r2.z;
	r1.w = frac(r1.w);
	r1.w = r1.w * r2.y;
	r2.y = frac(r1.w);
	r2.z = r1.w + -r2.y;
	r2.y = (-r2.y >= 0) ? 0 : 1;
	r1.w = (r1.w >= 0) ? 0 : r2.y;
	r1.w = r1.w + r2.z;
	r2.y = (-abs(r1.w) >= 0) ? 1 : 0;
	r3 = 0.5 + -i.texcoord.xyxy;
	r2.z = dot(r3.zw, r3.zw) + 0;
	r2.z = rsqrt(r2.z);
	r2.z = 1 / r2.z;
	r2.z = r2.z * MP_BulletTimeParams.w;
	r2.z = r2.z * 1.4144272;
	r4.x = r2.z * r2.z;
	r2.z = saturate(r2.z * r4.x);
	r4.xy = i.texcoord.xy * 2 + -1;
	r4.z = r4.x * dofProj.z;
	r4.w = -r4.y * dofProj.w;
	r4.zw = r0.xx * r4.zw;
	r5.xyz = r4.www * motionBlurMatrix[1].xyz;
	r5.xyz = r4.zzz * motionBlurMatrix[0].xyz + r5.xyz;
	r5.xyz = -r0.xxx * motionBlurMatrix[2].xyz + r5.xyz;
	r5.xyz = r5.xyz + motionBlurMatrix[3].xyz;
	r0.x = -r5.z * dofProj.z;
	r0.x = 1 / r0.x;
	r6.xz = r0.xx * r5.xx;
	r0.x = r5.z * dofProj.w;
	r0.x = 1 / r0.x;
	r6.yw = r0.xx * r5.yy;
	r5 = -r4.xyxy + r6;
	r6 = tex2D(VelocityBufferSampler, i.texcoord.xy);
	r6.xyz = r6.xyz + float3(-0.5, -0.5, 0.6);
	r7 = r6.xyxy + r6.xyxy;
	r8 = saturate(r6.xyxy * -2 + 0.15);
	r8 = r8 + 1;
	r7 = r7 * r8;
	r4.z = 12.5;
	r0.x = r4.z * TotalElapsedTime.x;
	r0.x = i.texcoord.y * 64 + r0.x;
	r0.x = r0.x * 0.15915494 + 0.5;
	r0.x = frac(r0.x);
	r0.x = r0.x * 6.2831855 + -3.1415927;
	r8.y = sin(r0.x);
	r0.x = r8.y * 0.015 + 0.05;
	r0.x = r0.x * 0.075 + 0.1;
	r7 = r0.x * r7;
	r6 = r6.z * r7;
	r0.x = dot(r6.zw, r6.zw) + 0;
	r0.x = rsqrt(r0.x);
	r0.x = 1 / r0.x;
	r0.x = saturate(r0.x * 16);
	r7 = tex2D(DOFSampler, 0.5);
	r5 = r5 * MP_BulletTimeParams.y;
	r3 = r3 * MP_BulletTimeParams.x + -r5;
	r3 = r3 * r2.z + r6;
	r3 = r2.y * r3;
	r3 = r3 * float4(0.5, 0.5, 0.75, 0.75) + i.texcoord.xyxy;
	r5 = tex2D(DOFSampler, r3.xy);
	r5.xyz = r5.xyz + r7.xyz;
	r3 = tex2D(DOFSampler, r3.zw);
	r3.xyz = r3.xyz + r5.xyz;
	r5.xyz = r3.xyz * 0.33333334 + -r0.yzw;
	r5.xyz = r0.xxx * r5.xyz + r0.yzw;
	r3.xyz = r3.xyz * 0.33333334 + -0.5;
	r2.y = r2.z * MP_BulletTimeParams.z + r2.w;
	r3.xyz = r3.xyz * r2.yyy + 0.5;
	r6.xyz = max(r3.xyz, 0);
	r3.xyz = min(r6.xyz, 10);
	r6.xyz = lerp(r0.yzw, r3.xyz, r2.zzz);
	r3.xyz = lerp(r6.xyz, r5.xyz, r0.xxx);
	r0.xyz = (-abs(r1.www) >= 0) ? r3.xyz : r0.yzw;
	r0.w = saturate(r1.z * ZoomBlurMaskSize.x);
	r0.w = -r0.w + 1;
	r1.w = r0.w * ImageFXParams.z;
	r2.x = ImageFXParams.z * r0.w + r2.x;
	r3.zw = dofProj.zw;
	r2.y = r3.z * -motionBlurMatrix[3].z;
	r2.y = 1 / r2.y;
	r3.x = r2.y * motionBlurMatrix[3].x;
	r2.y = r3.w * motionBlurMatrix[3].z;
	r2.y = 1 / r2.y;
	r3.y = r2.y * motionBlurMatrix[3].y;
	r2.yz = -r4.xy + r3.xy;
	r2.yz = r2.yz * ImageFXParams.yy;
	r2.yz = r2.yz * 0.125;
	r2.yz = r1.ww * -r2.yz + r2.yz;
	r0.w = saturate(ImageFXParams.z * r0.w + ImageFXParams.x);
	r3.xy = r2.yz + i.texcoord.xy;
	r5 = tex2D(BlurSampler, r3.xy);
	r5.xyz = r0.xyz + r5.xyz;
	r3 = tex2D(DOFSampler, r3.xy);
	r3.xyz = r0.xyz + r3.xyz;
	r4.zw = r2.yz * 2 + i.texcoord.xy;
	r6 = tex2D(BlurSampler, r4.zw);
	r5.xyz = r5.xyz + r6.xyz;
	r6 = tex2D(DOFSampler, r4.zw);
	r3.xyz = r3.xyz + r6.xyz;
	r6 = r2.yzyz * float4(3, 3, 4, 4) + i.texcoord.xyxy;
	r7 = tex2D(BlurSampler, r6.xy);
	r5.xyz = r5.xyz + r7.xyz;
	r7 = tex2D(DOFSampler, r6.xy);
	r3.xyz = r3.xyz + r7.xyz;
	r7 = tex2D(BlurSampler, r6.zw);
	r5.xyz = r5.xyz + r7.xyz;
	r6 = tex2D(DOFSampler, r6.zw);
	r3.xyz = r3.xyz + r6.xyz;
	r6 = r2.yzyz * float4(5, 5, 6, 6) + i.texcoord.xyxy;
	r7 = tex2D(BlurSampler, r6.xy);
	r5.xyz = r5.xyz + r7.xyz;
	r7 = tex2D(DOFSampler, r6.xy);
	r3.xyz = r3.xyz + r7.xyz;
	r7 = tex2D(BlurSampler, r6.zw);
	r5.xyz = r5.xyz + r7.xyz;
	r6 = tex2D(DOFSampler, r6.zw);
	r3.xyz = r3.xyz + r6.xyz;
	r2.yz = r2.yz * 7 + i.texcoord.xy;
	r6 = tex2D(BlurSampler, r2.yz);
	r5.xyz = r5.xyz + r6.xyz;
	r6 = tex2D(DOFSampler, r2.yz);
	r3.xyz = r3.xyz + r6.xyz;
	r6.xyz = lerp(r5.xyz, r3.xyz, r0.www);
	r3.xyz = r6.xyz * 0.125;
	r0.xyz = (r2.xxx >= 0) ? r0.xyz : r3.xyz;
	r0.w = 1 / globalScreenSize.x;
	r2.xy = ColorFringeParams1.ww * -r0.ww + i.texcoord.xy;
	r0.w = -r1.z + 1;
	r3.xyz = r0.www * ColorFringeParams1.xyz;
	r5 = tex2D(HDRPointSampler, r2.xy);
	r2.xyz = lerp(r0.xyz, r5.xyz, r3.xyz);
	r1.w = ColorFringeParams2.w;
	r1.zw = r1.ww * -globalScreenSize.zz + i.texcoord.xy;
	r3.xyz = r0.www * ColorFringeParams2.xyz;
	r5 = tex2D(HDRPointSampler, r1.zw);
	r0.xyz = -r0.xyz + r5.xyz;
	r0.xyz = r0.xyz * r3.xyz + r2.xyz;
	r3 = tex2D(AdapLumSampler, 0);
	r0.w = r3.x + 1E-06;
	r0.w = 1 / r0.w;
	r0.w = r0.w * ToneMapParams.y;
	r3 = tex2D(BloomSampler, i.texcoord.xy);
	r2.x = lerp(ToneMapParams.z, ToneMapParams.w, r1.x);
	r2.xyz = r2.xxx * r3.xyz;
	r0.xyz = r2.xyz * 0.25 + r0.xyz;
	r2.x = lerp(Exposures.x, Exposures.y, r1.x);
	r0.xyz = r0.xyz * r2.xxx;
	r1.x = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.z = r0.w * r1.x;
	r1.w = BurnoutLimit.x * BurnoutLimit.x;
	r1.w = 1 / r1.w;
	r1.w = r1.z * r1.w + 1;
	r1.z = r1.w * r1.z;
	r0.w = r1.x * r0.w + 1;
	r0.w = 1 / r0.w;
	r0.w = r0.w * r1.z;
	r0.xyz = r0.www * r0.xyz;
	r0.w = saturate(dot(r0.xyz, float3(0.2125, 0.7154, 0.0721)));
	r0.w = r0.w + 1.01E-05;
	r1.z = deSatContrastGamma.z;
	r1.x = -r1.z + deSatContrastGammaIFX.z;
	r1.x = r1.y * r1.x + deSatContrastGamma.z;
	r1.x = r1.x + -0.99999;
	r2.x = pow(r0.w, r1.x);
	r0.xyz = r0.xyz * r2.xxx;
	if (deathIntensity.x != -deathIntensity.x) {
		r0.w = r2.w + -deathIntensity.x;
		r1.x = r0.w * 1.4142135;
		r2 = tex2D(DeathSampler, i.texcoord.xy);
		r1.x = dot(r4.xy, r4.xy) + -r1.x;
		r0.w = r0.w * -1.4142135 + 1.4142135;
		r0.w = 1 / r0.w;
		r0.w = saturate(r0.w * r1.x);
		r1.xyz = r0.xyz * r2.xyz + -r0.xyz;
		r0.xyz = r0.www * r1.xyz + r0.xyz;
	}
	r0.xyz = r0.xyz * BrightnessSetting.xxx + BrightnessSetting.yyy;
	r1.xyz = saturate(r0.xyz);
	o.w = dot(r1.xyz, float3(0.299, 0.587, 0.114));
	o.xyz = r0.xyz;

	return o;
}
