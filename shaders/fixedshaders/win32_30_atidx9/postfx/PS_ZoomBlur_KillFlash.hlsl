sampler2D AdapLumSampler : register(s1);
sampler2D BloomSampler : register(s10);
sampler2D BlurSampler : register(s7);
float2 BrightnessSetting : register(c130);
float BurnoutLimit : register(c142);
sampler2D DOFSampler : register(s9);
sampler2D DeathSampler : register(s15);
float2 Exposures : register(c137);
sampler2D HDRPointSampler : register(s6);
float4 ImageFXParams : register(c146);
float4 KillFlashCol : register(c145);
float4 KillFlashUVOff : register(c144);
sampler2D RadialBlurSampler : register(s14);
sampler2D StencilCopySampler : register(s8);
float4 ToneMapParams : register(c139);
float ZoomBlurMaskSize : register(c147);
float blurIntensity : register(c197);
float4 deSatContrastGamma : register(c46);
float4 deSatContrastGammaIFX : register(c75);
float deathIntensity : register(c198);
float4 dofProj : register(c132);
row_major float4x4 motionBlurMatrix : register(c150);
float radialBlurScale : register(c193);
float2 radialBlurTextureStep : register(c196);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float2 texcoord1 : TEXCOORD1;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	r0 = tex2D(HDRPointSampler, i.texcoord.xy);
	r1.xzw = float3(-1, 1, 2);
	r0.w = r1.x + radialBlurScale.x;
	r2.xy = radialBlurTextureStep.xy + i.texcoord.xy;
	r2 = tex2D(RadialBlurSampler, r2.xy);
	r2.xyz = r0.xyz * radialBlurScale.xxx + r2.xyz;
	r0.xyz = (-abs(r0.www) >= 0) ? r0.xyz : r2.xyz;
	if (blurIntensity.x != -blurIntensity.x) {
		r2 = tex2D(BlurSampler, i.texcoord.xy);
		r3.xyz = lerp(r0.xyz, r2.xyz, blurIntensity.xxx);
		r0.xyz = r3.xyz;
	}
	r2 = tex2D(DeathSampler, i.texcoord1.xy);
	r0.w = abs(deathIntensity.x);
	r2.xyz = (-r0.www >= 0) ? r2.xzw : 0;
	r0.w = saturate(r2.z * ZoomBlurMaskSize.x);
	r0.w = -r0.w + 1;
	r1.y = r0.w * ImageFXParams.z;
	r2.z = ImageFXParams.z * r0.w + r1.x;
	r3.z = motionBlurMatrix[3].z;
	r2.w = -r3.z * dofProj.z;
	r2.w = 1 / r2.w;
	r3.x = r2.w * motionBlurMatrix[3].x;
	r2.w = r3.z * dofProj.w;
	r2.w = 1 / r2.w;
	r3.y = r2.w * motionBlurMatrix[3].y;
	r3.zw = i.texcoord.xy * 2 + -1;
	r3.xy = -r3.zw + r3.xy;
	r3.xy = r3.xy * ImageFXParams.yy;
	r3.xy = r3.xy * 0.125;
	r3.xy = r1.yy * -r3.xy + r3.xy;
	r0.w = saturate(ImageFXParams.z * r0.w + ImageFXParams.x);
	r4.xy = r3.xy + i.texcoord.xy;
	r5 = tex2D(BlurSampler, r4.xy);
	r5.xyz = r0.xyz + r5.xyz;
	r4 = tex2D(DOFSampler, r4.xy);
	r4.xyz = r0.xyz + r4.xyz;
	r6.xy = r3.xy * 2 + i.texcoord.xy;
	r7 = tex2D(BlurSampler, r6.xy);
	r5.xyz = r5.xyz + r7.xyz;
	r6 = tex2D(DOFSampler, r6.xy);
	r4.xyz = r4.xyz + r6.xyz;
	r6 = r3.xyxy * float4(3, 3, 4, 4) + i.texcoord.xyxy;
	r7 = tex2D(BlurSampler, r6.xy);
	r5.xyz = r5.xyz + r7.xyz;
	r7 = tex2D(DOFSampler, r6.xy);
	r4.xyz = r4.xyz + r7.xyz;
	r7 = tex2D(BlurSampler, r6.zw);
	r5.xyz = r5.xyz + r7.xyz;
	r6 = tex2D(DOFSampler, r6.zw);
	r4.xyz = r4.xyz + r6.xyz;
	r6 = r3.xyxy * float4(5, 5, 6, 6) + i.texcoord.xyxy;
	r7 = tex2D(BlurSampler, r6.xy);
	r5.xyz = r5.xyz + r7.xyz;
	r7 = tex2D(DOFSampler, r6.xy);
	r4.xyz = r4.xyz + r7.xyz;
	r7 = tex2D(BlurSampler, r6.zw);
	r5.xyz = r5.xyz + r7.xyz;
	r6 = tex2D(DOFSampler, r6.zw);
	r4.xyz = r4.xyz + r6.xyz;
	r3.xy = r3.xy * 7 + i.texcoord.xy;
	r6 = tex2D(BlurSampler, r3.xy);
	r5.xyz = r5.xyz + r6.xyz;
	r6 = tex2D(DOFSampler, r3.xy);
	r4.xyz = r4.xyz + r6.xyz;
	r6.xyz = lerp(r5.xyz, r4.xyz, r0.www);
	r4.xyz = r6.xyz * 0.125;
	r0.xyz = (r2.zzz >= 0) ? r0.xyz : r4.xyz;
	r4 = tex2D(DeathSampler, i.texcoord.xy);
	r2.zw = KillFlashUVOff.xy + i.texcoord.xy;
	r5 = tex2D(HDRPointSampler, r2.zw);
	r6 = tex2D(StencilCopySampler, r2.zw);
	r0.w = r6.w + -0.5015686;
	r1.y = (r0.w >= 0) ? -128 : -0;
	r1.y = r6.w * 255 + r1.y;
	r2.z = r1.y + -63.9;
	r2.z = (r2.z >= 0) ? -64 : -0;
	r1.y = r1.y + r2.z;
	r2.z = r1.y + -31.9;
	r2.z = (r2.z >= 0) ? -32 : -0;
	r1.y = r1.y + r2.z;
	r2.z = r1.y + -15.9;
	r2.z = (r2.z >= 0) ? -16 : -0;
	r1.y = r1.y + r2.z;
	r2.z = r1.y + -7.9;
	r2.z = (r2.z >= 0) ? -8 : -0;
	r1.y = r1.y + r2.z;
	r1.y = r1.y + -1;
	r1.y = -abs(r1.y) + 0.1;
	r1.y = (r1.y >= 0) ? 1 : 0;
	r2.z = abs(KillFlashUVOff.w);
	r2.zw = r2.zz + float2(-1, -2);
	r3.x = (r0.w >= 0) ? 0 : r1.y;
	r0.w = (r0.w >= 0) ? r1.y : 0;
	r0.w = (-abs(r2.w) >= 0) ? r0.w : r1.y;
	r0.w = (-abs(r2.z) >= 0) ? r3.x : r0.w;
	r1.y = -r0.w + 1;
	r1.y = r1.y * KillFlashCol.w;
	r0.w = r0.w * KillFlashCol.w;
	r0.w = (KillFlashUVOff.w >= 0) ? r0.w : r1.y;
	r6.xyz = -r5.xyz + 1;
	r1.xyw = KillFlashCol.xyz * r1.www + r1.xxx;
	r6.xyz = r1.xyw * r6.xyz;
	r7.xyz = r1.xyw * r5.xyz;
	r1.xyw = (-r1.xyw >= 0) ? r7.xyz : r6.xyz;
	r1.xyw = r1.xyw + r5.xyz;
	r0.w = saturate(r4.y * r0.w);
	r5.xyz = lerp(r0.xyz, r1.xyw, r0.www);
	r1.xyw = (-r4.yyy >= 0) ? r0.xyz : r5.xyz;
	r0.xyz = (-KillFlashCol.www >= 0) ? r0.xyz : r1.xyw;
	r5 = tex2D(AdapLumSampler, 0);
	r0.w = r5.x + 1E-06;
	r0.w = 1 / r0.w;
	r0.w = r0.w * ToneMapParams.y;
	r5 = tex2D(BloomSampler, i.texcoord.xy);
	r1.x = lerp(ToneMapParams.z, ToneMapParams.w, r2.x);
	r1.xyw = r1.xxx * r5.xyz;
	r0.xyz = r1.xyw * 0.25 + r0.xyz;
	r1.x = lerp(Exposures.x, Exposures.y, r2.x);
	r0.xyz = r0.xyz * r1.xxx;
	r1.x = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.y = r0.w * r1.x;
	r1.w = BurnoutLimit.x * BurnoutLimit.x;
	r1.w = 1 / r1.w;
	r1.w = r1.y * r1.w + 1;
	r1.y = r1.w * r1.y;
	r0.w = r1.x * r0.w + 1;
	r0.w = 1 / r0.w;
	r0.w = r0.w * r1.y;
	r0.xyz = r0.www * r0.xyz;
	r0.w = saturate(dot(r0.xyz, float3(0.2125, 0.7154, 0.0721)));
	r0.w = r0.w + 1.01E-05;
	r2.z = deSatContrastGamma.z;
	r1.x = -r2.z + deSatContrastGammaIFX.z;
	r1.x = r2.y * r1.x + deSatContrastGamma.z;
	r1.x = r1.x + -0.99999;
	r2.x = pow(r0.w, r1.x);
	r0.xyz = r0.xyz * r2.xxx;
	if (deathIntensity.x != -deathIntensity.x) {
		r0.w = r1.z + -deathIntensity.x;
		r1.x = r0.w * 1.4142135;
		r1.x = dot(r3.zw, r3.zw) + -r1.x;
		r0.w = r0.w * -1.4142135 + 1.4142135;
		r0.w = 1 / r0.w;
		r0.w = saturate(r0.w * r1.x);
		r1.xyz = r0.xyz * r4.xyz + -r0.xyz;
		r0.xyz = r0.www * r1.xyz + r0.xyz;
	}
	r0.xyz = r0.xyz * BrightnessSetting.xxx + BrightnessSetting.yyy;
	r1.xyz = saturate(r0.xyz);
	o.w = dot(r1.xyz, float3(0.299, 0.587, 0.114));
	o.xyz = r0.xyz;

	return o;
}
