sampler2D AdapLumSampler : register(s1);
sampler2D BloomSampler : register(s10);
sampler2D BlurSampler : register(s7);
float2 BrightnessSetting : register(c135);
float BurnoutLimit : register(c147);
float4 ColorCorrectBottomOffset : register(c44);
float4 ColorCorrectTopAndPedReflectScale : register(c43);
float2 Exposures : register(c142);
sampler2D GBufferTextureSamplerDepth : register(s3);
sampler2D HDRPointSampler : register(s6);
float4 HeatHazeOffsetParams : register(c185);
float4 HeatHazeParams : register(c182);
sampler2D HeatHazeSampler : register(s12);
float4 HeatHazeTex1Params : register(c183);
float4 HeatHazeTex2Params : register(c184);
sampler2D RadialBlurSampler : register(s14);
float4 ToneMapParams : register(c144);
float blurIntensity : register(c203);
float4 deSatContrastGamma : register(c46);
float4 dofProj : register(c136);
float radialBlurScale : register(c199);
float2 radialBlurTextureStep : register(c202);

float4 main(float2 texcoord : TEXCOORD) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	r0 = tex2D(GBufferTextureSamplerDepth, texcoord.xy);
	r0.y = -dofProj.x + dofProj.y;
	r0.y = 1 / r0.y;
	r0.z = r0.y * dofProj.y;
	r0.z = r0.z * -dofProj.x;
	r0.x = dofProj.y * -r0.y + r0.x;
	r0.x = 1 / r0.x;
	r0.y = r0.x * r0.z;
	r0.x = r0.z * r0.x + -HeatHazeParams.x;
	r1.x = max(r0.x, 0);
	r0.x = 1 / HeatHazeParams.y;
	r0.x = saturate(r0.x * r1.x);
	r1.x = lerp(HeatHazeParams.z, HeatHazeParams.w, r0.x);
	r1.yw = float2(0.5, -1);
	r0.x = dofProj.y * -r1.y + r0.y;
	r1.y = max(r0.x, 0);
	r0.x = 1 / dofProj.y;
	r0.x = saturate(r0.x * r1.y);
	r0.x = -r0.x + 1;
	r0.x = r0.x * r1.x;
	r0.yz = texcoord.xy * HeatHazeTex1Params.xy + HeatHazeTex1Params.zw;
	r1.xy = texcoord.xy * HeatHazeTex2Params.xy + HeatHazeTex2Params.zw;
	r2 = tex2D(HeatHazeSampler, r0.yz);
	r3 = tex2D(HeatHazeSampler, r1.xy);
	r0.yz = r2.xy + r3.xy;
	r0.yz = r0.yz + -1;
	r0.yz = r0.yz * HeatHazeOffsetParams.xy;
	r0.xy = r0.yz * r0.xx + texcoord.xy;
	r2 = tex2D(HDRPointSampler, r0.xy);
	r0.x = r1.w + radialBlurScale.x;
	r0.zw = radialBlurTextureStep.xy + texcoord.xy;
	r1 = tex2D(RadialBlurSampler, r0.zw);
	r1.xyz = r2.xyz * radialBlurScale.xxx + r1.xyz;
	r0.xzw = (-abs(r0.xxx) >= 0) ? r2.xyz : r1.xyz;
	if (blurIntensity.x != -blurIntensity.x) {
		r1 = tex2D(BlurSampler, texcoord.xy);
		r2.xyz = lerp(r0.xzw, r1.xyz, blurIntensity.xxx);
		r0.xzw = r2.xyz;
	}
	r1 = tex2D(AdapLumSampler, 0);
	r1.x = r1.x + 1E-06;
	r1.x = 1 / r1.x;
	r1.x = r1.x * ToneMapParams.y;
	r2 = tex2D(BloomSampler, texcoord.xy);
	r1.yzw = r2.xyz * ToneMapParams.zzz;
	r0.xzw = r1.yzw * 0.25 + r0.xzw;
	r2.xyz = ColorCorrectBottomOffset.xyz;
	r1.yzw = r0.yyy * r2.xyz + ColorCorrectTopAndPedReflectScale.xyz;
	r0.xyz = r0.xzw * r1.yzw;
	r0.xyz = r0.xyz * Exposures.xxx;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.y = r1.x * r0.w;
	r1.z = BurnoutLimit.x * BurnoutLimit.x;
	r1.z = 1 / r1.z;
	r1.z = r1.y * r1.z + 1;
	r1.y = r1.z * r1.y;
	r0.w = r0.w * r1.x + 1;
	r0.w = 1 / r0.w;
	r0.w = r0.w * r1.y;
	r0.xyz = r0.www * r0.xyz;
	r0.w = saturate(dot(r0.xyz, float3(0.2125, 0.7154, 0.0721)));
	r0.w = r0.w + 1.01E-05;
	r1.w = -0.99999;
	r1.x = r1.w + deSatContrastGamma.z;
	r2.x = pow(r0.w, r1.x);
	r0.w = min(r2.x, 65000);
	r0.xyz = r0.www * r0.xyz;
	r0.xyz = r0.xyz * BrightnessSetting.xxx + BrightnessSetting.yyy;
	r1.xyz = saturate(r0.xyz);
	o.w = dot(r1.xyz, float3(0.299, 0.587, 0.114));
	o.xyz = r0.xyz;

	return o;
}
