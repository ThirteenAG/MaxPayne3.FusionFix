cbuffer rage_globals : register(b5)
{
	float4 globalScalars : packoffset(c0);
	float4 globalScalars2 : packoffset(c1);
	float4 globalScalars3 : packoffset(c2);
	float4 globalScalars4 : packoffset(c3);
	float4 globalFogParams : packoffset(c4);
	float4 globalFogColor : packoffset(c5);
	float4 globalFogOffsetN : packoffset(c6);
	float4 globalFogColorN : packoffset(c7);
	float4 globalScreenSize : packoffset(c8);
	float4 globalDayNightEffects : packoffset(c9);
	float4 ColorCorrectTopAndPedReflectScale : packoffset(c10);
	float4 ColorCorrectBottomOffset : packoffset(c11);
	float4 ColorShift : packoffset(c12);
	float4 deSatContrastGamma : packoffset(c13);
	float4 deSatContrastGammaIFX : packoffset(c14);
};

SamplerState AdapLumSampler : register(s1);
SamplerState HDRPointSampler : register(s6);
SamplerState BlurSampler : register(s7);
SamplerState BloomSampler : register(s10);
SamplerState RadialBlurSampler : register(s14);
SamplerState DeathSampler : register(s15);
Texture2D AdapLumSampler_tex : register(t1);
Texture2D<float> gbufferTextureDepth : register(t3);
Texture2D HDRPointSampler_tex : register(t6);
Texture2D BlurSampler_tex : register(t7);
Texture2D BloomSampler_tex : register(t10);
Texture2D RadialBlurSampler_tex : register(t14);
Texture2D DeathSampler_tex : register(t15);

struct PS_IN
{
	float4 sv_position : SV_Position;
	float2 texcoord : TEXCOORD;
	float2 texcoord1 : TEXCOORD1;
	float2 texcoord2 : TEXCOORD2;
};

float4 main(PS_IN i) : SV_Target
{
	float4 o;

	int4 r0;
	int4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 dimensions0 = 0;
	gbufferTextureDepth.GetDimensions(0, dimensions0.x, dimensions0.y, dimensions0.w);
	r0 = asint(dimensions0);
	r0.xy = asint(asfloat(r0.xy) * i.texcoord.xy);
	r0.xy = (int2)asfloat(r0.xy);
	r0.zw = int2(0, 0);
	r0.x = asint(gbufferTextureDepth.Load(r0.xyz));
	r0.yzw = asint(float3(0, 0, 1));
	r0.y = asint(-(dofProj.x) + dofProj.y);
	r0.y = asint(dofProj.y / asfloat(r0.y));
	r0.z = asint(asfloat(r0.y) * -(dofProj.x));
	r0.x = asint(-(asfloat(r0.y)) + asfloat(r0.x));
	r0.x = asint(asfloat(r0.z) / asfloat(r0.x));
	r0.y = asint(-(asfloat(r0.x)) + ZoomFocusDistance);
	r0.y = asint(saturate(asfloat(r0.y) * 0.200000003));
	r0.z = asint(-(asfloat(r0.x)) + dofDist.y);
	r0.x = asint(asfloat(r0.x) + -(dofDist.z));
	r0.xz = asint(saturate(asfloat(r0.xz) / dofDist.wx));
	r0.x = asint(max(asfloat(r0.x), asfloat(r0.z)));
	r0.x = asint(asfloat(r0.x) * dofInten);
	r0.x = asint(max(asfloat(r0.x), asfloat(r0.y)));
	r1 = asint(HDRPointSampler_tex.Sample(HDRPointSampler, i.texcoord.xy));
	r0.y = (radialBlurScale != 1) ? -1 : 0;
	if (r0.y != 0) {
		r0.yz = asint(i.texcoord.xy + radialBlurTextureStep.xy);
		r2 = RadialBlurSampler_tex.Sample(RadialBlurSampler, asfloat(r0.yz));
		r1.xyz = asint(asfloat(r1.xyz) * radialBlurScale + r2.xyz);
	}
	r0.y = (0 != blurIntensity) ? -1 : 0;
	if (r0.y != 0) {
		r2 = BlurSampler_tex.Sample(BlurSampler, i.texcoord.xy);
		r0.yzw = asint(-(asfloat(r1.xyz)) + r2.xyz);
		r1.xyz = asint(blurIntensity * asfloat(r0.yzw) + asfloat(r1.xyz));
	}
	r2 = DeathSampler_tex.Sample(DeathSampler, i.texcoord1);
	r0.y = asint(ColorFringeParams1.w / globalScreenSize.x);
	r0.yz = asint(-(asfloat(r0.yy)) + i.texcoord.xy);
	r0.w = asint(-(r2.w) + 1);
	r3.xyz = asfloat(r0.www) * ColorFringeParams1.xyz;
	r4 = HDRPointSampler_tex.Sample(HDRPointSampler, asfloat(r0.yz));
	r4.xyz = -(asfloat(r1.xyz)) + r4.xyz;
	r3.xyz = r4.xyz * r3.xyz + asfloat(r1.xyz);
	r0.yz = asint(-(ColorFringeParams2.ww) * globalScreenSize.zz + i.texcoord.xy);
	r4.xyz = asfloat(r0.www) * ColorFringeParams2.xyz;
	r5 = HDRPointSampler_tex.Sample(HDRPointSampler, asfloat(r0.yz));
	r0.yzw = asint(-(asfloat(r1.xyz)) + r5.xyz);
	r0.yzw = asint(asfloat(r0.yzw) * r4.xyz + r3.xyz);
	r1 = asint(BlurSampler_tex.Sample(BlurSampler, i.texcoord.xy));
	r1.xyz = asint(-(asfloat(r0.yzw)) + asfloat(r1.xyz));
	r0.xyz = asint(asfloat(r0.xxx) * asfloat(r1.xyz) + asfloat(r0.yzw));
	r1 = asint(AdapLumSampler_tex.Sample(AdapLumSampler, float2(0, 0)));
	r0.w = asint(asfloat(r1.x) + 0.000000999999997);
	r0.w = asint(ToneMapParams.y / asfloat(r0.w));
	r1 = asint(BloomSampler_tex.Sample(BloomSampler, i.texcoord.xy));
	r1.w = asint(-(ToneMapParams.z) + ToneMapParams.w);
	r1.w = asint(r2.x * asfloat(r1.w) + ToneMapParams.z);
	r1.xyz = asint(asfloat(r1.www) * asfloat(r1.xyz));
	r0.xyz = asint(asfloat(r1.xyz) * float3(0.25, 0.25, 0.25) + asfloat(r0.xyz));
	r1.x = asint(dot(asfloat(r0.xyz), float3(1, 1, 1)));
	r1.x = asint(asfloat(r1.x) + -1.5);
	r1.x = asint(max(asfloat(r1.x), 0));
	r1.y = asint(0.100000001 + DruggedEffectParams.z);
	r3.y = asfloat(r1.y) * DruggedEffectParams.w;
	r1.y = asint(i.texcoord.x + -0.5);
	r1.y = asint(r3.y * -(asfloat(r1.y)));
	r1.z = asint(asfloat(r1.x) + 2);
	r3.x = asfloat(r1.z) * asfloat(r1.y);
	r1.yz = asint(r3.xy + i.texcoord.xy);
	r4 = BlurSampler_tex.Sample(BlurSampler, asfloat(r1.yz));
	r1.yz = asint(r3.xy + asfloat(r1.yz));
	r3 = BlurSampler_tex.Sample(BlurSampler, asfloat(r1.yz));
	r1.y = asint(dot(r4.xyz, float3(1, 1, 1)));
	r1.y = asint(asfloat(r1.y) + -1.5);
	r1.z = asint(dot(r3.xyz, float3(1, 1, 1)));
	r1.z = asint(asfloat(r1.z) + -1.5);
	r1.yz = asint(max(asfloat(r1.yz), float2(0, 0)));
	r2.y = asfloat(r1.z) + asfloat(r1.y);
	r2.y = r2.y * DruggedEffectParams.z;
	r2.y = r2.y * 0.5;
	r3.xyz = max(r3.xyz, r4.xyz);
	r3.xyz = r3.xyz * DruggedEffectColorShift.xyz;
	r3.xyz = r3.xyz * DruggedEffectParams.zzz;
	r3.xyz = r3.xyz + r3.xyz;
	r0.xyz = asint(max(asfloat(r0.xyz), r3.xyz));
	r2.w = -(asfloat(r1.y)) + asfloat(r1.x);
	r1.xy = asint(-(asfloat(r1.zz)) + asfloat(r1.xy));
	r1.x = asint(abs(asfloat(r1.x)) + abs(r2.w));
	r1.x = asint(abs(asfloat(r1.y)) + asfloat(r1.x));
	r1.x = asint(asfloat(r1.x) * DruggedEffectParams.x);
	r1.x = asint(min(asfloat(r1.x), r2.y));
	r1.x = asint(asfloat(r1.w) * r2.y + -(asfloat(r1.x)));
	r1.x = asint(min(asfloat(r1.x), 1));
	r0.xyz = asint(asfloat(r0.xyz) + asfloat(r1.xxx));
	r0.xyz = asint(max(asfloat(r0.xyz), float3(0, 0, 0)));
	r1.xyz = asint(i.texcoord.yyy * ColorCorrectBottomOffset.xyz + ColorCorrectTopAndPedReflectScale.xyz);
	r0.xyz = asint(asfloat(r0.xyz) * asfloat(r1.xyz));
	r1.x = asint(-(Exposures.x) + Exposures.y);
	r1.x = asint(r2.x * asfloat(r1.x) + Exposures.x);
	r0.xyz = asint(asfloat(r0.xyz) * asfloat(r1.xxx));
	r1.x = asint(dot(asfloat(r0.xyz), float3(0.212500006, 0.715399981, 0.0720999986)));
	r1.y = asint(asfloat(r0.w) * asfloat(r1.x));
	r1.z = asint(BurnoutLimit * BurnoutLimit);
	r1.z = asint(asfloat(r1.y) / asfloat(r1.z));
	r1.z = asint(asfloat(r1.z) + 1);
	r1.y = asint(asfloat(r1.z) * asfloat(r1.y));
	r0.w = asint(asfloat(r1.x) * asfloat(r0.w) + 1);
	r0.w = asint(asfloat(r1.y) / asfloat(r0.w));
	r0.xyz = asint(asfloat(r0.www) * asfloat(r0.xyz));
	r0.w = asint(saturate(dot(asfloat(r0.xyz), float3(0.212500006, 0.715399981, 0.0720999986))));
	r0.w = asint(asfloat(r0.w) + 0.0000100999996);
	r1.x = asint(-(deSatContrastGamma.z) + deSatContrastGammaIFX.z);
	r1.x = asint(r2.z * asfloat(r1.x) + deSatContrastGamma.z);
	r1.x = asint(asfloat(r1.x) + -0.999989986);
	r0.w = asint(log2(asfloat(r0.w)));
	r0.w = asint(asfloat(r0.w) * asfloat(r1.x));
	r0.w = asint(exp2(asfloat(r0.w)));
	r0.w = asint(min(asfloat(r0.w), 65000));
	r0.xyz = asint(asfloat(r0.www) * asfloat(r0.xyz));
	r0.xyz = asint(asfloat(r0.xyz) * BrightnessSetting.xxx + BrightnessSetting.yyy);
	r1.xyz = asint(saturate(asfloat(r0.xyz)));
	o.w = dot(asfloat(r1.xyz), float3(0.298999995, 0.587000012, 0.114000000));
	o.xyz = asfloat(r0.xyz);

	return o;
}
