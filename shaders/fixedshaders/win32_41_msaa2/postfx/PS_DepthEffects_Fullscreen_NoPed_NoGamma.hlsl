	float4 deSatContrastGamma : packoffset(c13);
};

Texture2DMS<float> gbufferTextureDepth : register(t3);
Texture2DMS<float4> PostFxTexture0a : register(t6);

struct PS_IN
{
	float4 sv_position : SV_Position;
	float2 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	nointerpolation uint sv_sampleindex : SV_SampleIndex;
};

float4 main(PS_IN i) : SV_Target
{
	float4 o;

	int4 r0;
	float4 r1;
	float3 dimensions0;
	PostFxTexture0a.GetDimensions(dimensions0.x, dimensions0.y, dimensions0.z);
	r0.xy = asint(dimensions0.xy);
	r0.xy = asint(asfloat(r0.xy) * i.texcoord.xy);
	r0.xy = (int2)asfloat(r0.xy);
	r0.zw = int2(0, 0);
	r0.z = asint(gbufferTextureDepth.Load(r0.xy, i.sv_sampleindex).x);
	r1 = PostFxTexture0a.Load(r0.xy, i.sv_sampleindex);
	r0.x = asint(-(dofProj.x) + dofProj.y);
	r0.x = asint(dofProj.y / asfloat(r0.x));
	r0.y = asint(-(asfloat(r0.x)) + asfloat(r0.z));
	r0.x = asint(asfloat(r0.x) * -(dofProj.x));
	r0.x = asint(asfloat(r0.x) / asfloat(r0.y));
	r0.xyz = asint(-(asfloat(r0.xxx)) * i.texcoord1.xyz);
	r0.w = asint(asfloat(r0.z) * globalFogParams.x);
	r0.x = asint(dot(asfloat(r0.xyz), asfloat(r0.xyz)));
	r0.x = asint(sqrt(asfloat(r0.x)));
	r0.x = asint(asfloat(r0.x) * globalFogParams.z);
	r0.y = asint(asfloat(r0.w) * -1.44269502);
	r0.y = asint(exp2(asfloat(r0.y)));
	r0.y = asint(-(asfloat(r0.y)) + 1);
	r0.y = asint(asfloat(r0.y) / asfloat(r0.w));
	r0.z = (0.0000999999975 < abs(asfloat(r0.w))) ? -1 : 0;
	r0.y = asint(asfloat(r0.y) * asfloat(r0.x));
	r0.x = (r0.z != 0) ? r0.y : r0.x;
	r0.x = asint(asfloat(r0.x) * -(globalFogParams.y));
	r0.x = asint(asfloat(r0.x) * 1.44269502);
	r0.x = asint(saturate(exp2(asfloat(r0.x))));
	r0.yzw = asint(r1.xyz + -(globalFogColorN.xyz));
	o.w = r1.w;
	r0.xyz = asint(asfloat(r0.xxx) * asfloat(r0.yzw) + globalFogColorN.xyz);
	r0.w = asint(dot(asfloat(r0.xyz), float3(0.212500006, 0.715399981, 0.0720999986)));
	r0.xyz = asint(-(asfloat(r0.www)) + asfloat(r0.xyz));
	r1.x = gAdrenoFXVars.x * deSatContrastGamma.x;
	r0.xyz = asint(r1.xxx * asfloat(r0.xyz) + asfloat(r0.www));
	r0.w = asint(asfloat(r0.w) * ColorShift.w);
	r0.xyz = asint(-(ColorShift.xyz) * asfloat(r0.www) + asfloat(r0.xyz));
	r1.xyz = asfloat(r0.www) * ColorShift.xyz;
	r0.w = asint(saturate(asfloat(r0.w)));
	o.xyz = asfloat(r0.www) * asfloat(r0.xyz) + r1.xyz;

	return o;
}
