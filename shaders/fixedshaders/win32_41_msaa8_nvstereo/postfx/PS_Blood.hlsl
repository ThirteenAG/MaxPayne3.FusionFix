SamplerState AdapLumSampler : register(s1);
SamplerState HDRSampler : register(s5);
SamplerState BlurSampler : register(s7);
SamplerState BloomSampler : register(s10);
Texture2D AdapLumSampler_tex : register(t1);
Texture2D HDRSampler_tex : register(t5);
Texture2D BlurSampler_tex : register(t7);
Texture2D BloomSampler_tex : register(t10);

struct PS_IN
{
	float4 sv_position : SV_Position;
	float2 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float4 color : COLOR;
};

float4 main(PS_IN i) : SV_Target
{
	float4 o;

	float4 r0;
	float3 r1;
	float3 r2;
	float3 r3;
	r0.xy = BlurSampler_tex.Sample(BlurSampler, i.texcoord.xy).xy;
	r0.xy = r0.xy * float2(2, 2) + i.texcoord1.xy;
	r0.xy = r0.xy + float2(-1, -1);
	r0.xyz = BloomSampler_tex.Sample(BloomSampler, r0.xy).xyz;
	r0.w = 0.00000999999975 + g_BloodSplatParams.x;
	r1.x = HDRSampler_tex.Sample(HDRSampler, i.texcoord.xy).x;
	r1.x = -(r1.x) + 1;
	r1.y = abs(r1.x) + 0.00000999999975;
	r1.y = log2(r1.y);
	r0.w = r0.w * r1.y;
	r0.w = exp2(r0.w);
	r2.x = dot(float3(0.412456393, 0.357576102, 0.180437505), g_BloodColor.xyz);
	r2.z = dot(float3(0.0193339009, 0.119191997, 0.950304091), g_BloodColor.xyz);
	r1.y = AdapLumSampler_tex.Sample(AdapLumSampler, float2(0, 0)).x;
	r2.y = dot(float3(0.212672904, 0.715152204, 0.0721750036), g_BloodColor.xyz);
	r1.z = r1.y / r2.y;
	r1.y = r1.y + 0.000000999999997;
	r1.y = ToneMapParams.y / r1.y;
	r2 = r1.zzz * r2.xyz;
	r3.x = dot(float3(3.24045420, -1.53713846, -0.498531401), r2.xyz);
	r3.y = dot(float3(-0.969265997, 1.87601078, 0.0415560007), r2.xyz);
	r3.z = dot(float3(0.0556433983, -0.204025894, 1.05722523), r2.xyz);
	r2 = -(r3.xyz) + g_BloodColor.xyz;
	r2 = r0.www * r2.xyz + r3.xyz;
	r0.w = saturate(r1.x * g_BloodSplatParams.y);
	r1.x = r1.x * r1.x + -(i.color.w);
	r1.x = saturate(r1.x * 1.39999998);
	r1.x = log2(r1.x);
	r0.w = -(r0.w) + 1;
	r0.w = log2(r0.w);
	r0.w = r0.w * g_BloodSplatParams.z;
	r0.w = exp2(r0.w);
	r0.xyz = r0.xyz * r0.www + r2.xyz;
	r0.xyz = r0.xyz * Exposures.xxx;
	r0.w = dot(r0.xyz, float3(0.212500006, 0.715399981, 0.0720999986));
	r1.z = r1.y * r0.w;
	r0.w = r0.w * r1.y + 1;
	r1.y = BurnoutLimit * BurnoutLimit;
	r1.y = r1.z / r1.y;
	r1.y = r1.y + 1;
	r1.y = r1.y * r1.z;
	r0.w = r1.y / r0.w;
	r0.xyz = r0.www * r0.xyz;
	r0.w = saturate(dot(r0.xyz, float3(0.212500006, 0.715399981, 0.0720999986)));
	r0.w = r0.w + 0.0000100999996;
	r0.w = log2(r0.w);
	r1.y = deSatContrastGamma.z + -0.999989986;
	r0.w = r0.w * r1.y;
	r0.w = exp2(r0.w);
	r0.w = min(r0.w, 65000);
	o.xyz = r0.www * r0.xyz;
	r0.x = i.color.w + 1;
	r0.x = r1.x * r0.x;
	r0.x = exp2(r0.x);
	r0.y = saturate(-(i.color.w) + 1.10000002);
	o.w = r0.x / r0.y;

	return o;
}
