SamplerState AdapLumSampler : register(s1);
SamplerState BlurSampler : register(s7);
SamplerState BloomSampler : register(s10);
SamplerState HeatHazeSampler : register(s12);
SamplerState RadialBlurSampler : register(s14);
SamplerState DeathSampler : register(s15);
Texture2D AdapLumSampler_tex : register(t1);
Texture2DMS<float> gbufferTextureDepth : register(t3);
Texture2DMS<float4> PostFxTexture0a : register(t6);
Texture2D BlurSampler_tex : register(t7);
Texture2D BloomSampler_tex : register(t10);
Texture2D HeatHazeSampler_tex : register(t12);
Texture2D RadialBlurSampler_tex : register(t14);
Texture2D DeathSampler_tex : register(t15);

struct PS_IN
{
	float4 sv_position : SV_Position;
	float2 texcoord : TEXCOORD;
	float2 texcoord1 : TEXCOORD1;
	float2 texcoord2 : TEXCOORD2;
};

float4 main(PS_IN i) : SV_Target
{
	float4 o;

	int4 r0;
	int4 r1;
	float4 r2;
	int4 r3;
	int4 r4;
	float3 dimensions0;
	gbufferTextureDepth.GetDimensions(dimensions0.x, dimensions0.y, dimensions0.z);
	r0.xy = asint(dimensions0.xy);
	r0.xy = asint(asfloat(r0.xy) * i.texcoord.xy);
	r0.xy = (int2)asfloat(r0.xy);
	r0.zw = int2(0, 0);
	r0.x = asint(gbufferTextureDepth.Load(r0.xy, 0).x);
	r0.y = asint(-(dofProj.x) + dofProj.y);
	r0.y = asint(dofProj.y / asfloat(r0.y));
	r0.z = asint(asfloat(r0.y) * -(dofProj.x));
	r0.x = asint(-(asfloat(r0.y)) + asfloat(r0.x));
	r0.x = asint(asfloat(r0.z) / asfloat(r0.x));
	r0.y = asint(asfloat(r0.x) + -(HeatHazeParams.x));
	r0.y = asint(max(asfloat(r0.y), 0));
	r0.y = asint(saturate(asfloat(r0.y) / HeatHazeParams.y));
	r0.z = asint(-(HeatHazeParams.z) + HeatHazeParams.w);
	r0.y = asint(asfloat(r0.y) * asfloat(r0.z) + HeatHazeParams.z);
	r0.x = asint(-(dofProj.y) * 0.5 + asfloat(r0.x));
	r0.x = asint(max(asfloat(r0.x), 0));
	r0.x = asint(saturate(asfloat(r0.x) / dofProj.y));
	r0.x = asint(-(asfloat(r0.x)) + 1);
	r0.x = asint(asfloat(r0.x) * asfloat(r0.y));
	r0.yz = asint(i.texcoord.xy * HeatHazeTex1Params.xy + HeatHazeTex1Params.zw);
	r1.xy = asint(i.texcoord.xy * HeatHazeTex2Params.xy + HeatHazeTex2Params.zw);
	r0.yz = asint(HeatHazeSampler_tex.Sample(HeatHazeSampler, asfloat(r0.yz)).xy);
	r1.xy = asint(HeatHazeSampler_tex.Sample(HeatHazeSampler, asfloat(r1.xy)).xy);
	r0.yz = asint(asfloat(r0.yz) + asfloat(r1.xy));
	r0.yz = asint(asfloat(r0.yz) + float2(-1, -1));
	r0.yz = asint(asfloat(r0.yz) * HeatHazeOffsetParams.xy);
	r0.xy = asint(asfloat(r0.yz) * asfloat(r0.xx) + i.texcoord.xy);
	float3 dimensions1;
	PostFxTexture0a.GetDimensions(dimensions1.x, dimensions1.y, dimensions1.z);
	r0.zw = asint(dimensions1.xy);
	r1.xy = asint(asfloat(r0.xy) * asfloat(r0.zw));
	r1.xy = (int2)asfloat(r1.xy);
	r1.zw = int2(0, 0);
	r2.xyz = PostFxTexture0a.Load(r1.xy, 0).xyz;
	r1.xyz = asint(PostFxTexture0a.Load(r1.xy, 1).xyz);
	r1.xyz = asint(asfloat(r1.xyz) + r2.xyz);
	r1.xyz = asint(asfloat(r1.xyz) * float3(0.5, 0.5, 0.5));
	r0.x = (radialBlurScale != 1) ? -1 : 0;
	if (r0.x != 0) {
		r2.xy = i.texcoord.xy + radialBlurTextureStep.xy;
		r2.xyz = RadialBlurSampler_tex.Sample(RadialBlurSampler, r2.xy).xyz;
		r1.xyz = asint(asfloat(r1.xyz) * radialBlurScale + r2.xyz);
	}
	r0.x = (0 != blurIntensity) ? -1 : 0;
	if (r0.x != 0) {
		r2.xyz = BlurSampler_tex.Sample(BlurSampler, i.texcoord.xy).xyz;
		r2.xyz = -(asfloat(r1.xyz)) + r2.xyz;
		r1.xyz = asint(blurIntensity * r2.xyz + asfloat(r1.xyz));
	}
	// Match the non-MSAA scope mask without changing the sample resolve.
	float4 fringeMaskSample = DeathSampler_tex.Sample(DeathSampler, i.texcoord1);
	float fringeMask = 1.0f - fringeMaskSample.w;
	float3 maskedFringe1 = fringeMask * ColorFringeParams1.xyz;
	float3 maskedFringe2 = fringeMask * ColorFringeParams2.xyz;
	r2.xy = fringeMaskSample.xz;
	r0.x = asint(ColorFringeParams1.w / globalScreenSize.x);
	r2.zw = -(asfloat(r0.xx)) + i.texcoord.xy;
	r2.zw = asfloat(r0.zw) * r2.zw;
	r3.xy = (int2)r2.zw;
	r3.zw = int2(0, 0);
	r4.xyz = asint(PostFxTexture0a.Load(r3.xy, 0).xyz);
	r3.xyz = asint(PostFxTexture0a.Load(r3.xy, 1).xyz);
	r3.xyz = asint(asfloat(r3.xyz) + asfloat(r4.xyz));
	r3.xyz = asint(asfloat(r3.xyz) * maskedFringe1);
	r4.xyz = asint(asfloat(r1.xyz) * maskedFringe1);
	r3.xyz = asint(asfloat(r3.xyz) * float3(0.5, 0.5, 0.5) + -(asfloat(r4.xyz)));
	r3.xyz = asint(asfloat(r1.xyz) + asfloat(r3.xyz));
	r2.zw = -(ColorFringeParams2.ww) * globalScreenSize.zz + i.texcoord.xy;
	r0.xz = asint(asfloat(r0.zw) * r2.zw);
	r4.xy = (int2)asfloat(r0.xz);
	r4.zw = int2(0, 0);
	r0.xzw = asint(PostFxTexture0a.Load(r4.xy, 0).xyz);
	r4.xyz = asint(PostFxTexture0a.Load(r4.xy, 1).xyz);
	r0.xzw = asint(asfloat(r0.xzw) + asfloat(r4.xyz));
	r0.xzw = asint(asfloat(r0.xzw) * maskedFringe2);
	r1.xyz = asint(asfloat(r1.xyz) * maskedFringe2);
	r0.xzw = asint(asfloat(r0.xzw) * float3(0.5, 0.5, 0.5) + -(asfloat(r1.xyz)));
	r0.xzw = asint(asfloat(r0.xzw) + asfloat(r3.xyz));
	r1.x = asint(AdapLumSampler_tex.Sample(AdapLumSampler, float2(0, 0)).x);
	r1.x = asint(asfloat(r1.x) + 0.000000999999997);
	r1.x = asint(ToneMapParams.y / asfloat(r1.x));
	r1.yzw = asint(BloomSampler_tex.Sample(BloomSampler, i.texcoord.xy).xyz);
	r2.z = -(ToneMapParams.z) + ToneMapParams.w;
	r2.z = r2.x * r2.z + ToneMapParams.z;
	r1.yzw = asint(asfloat(r1.yzw) * r2.zzz);
	r0.xzw = asint(asfloat(r1.yzw) * float3(0.25, 0.25, 0.25) + asfloat(r0.xzw));
	r1.yzw = asint(asfloat(r0.yyy) * ColorCorrectBottomOffset.xyz + ColorCorrectTopAndPedReflectScale.xyz);
	r0.xyz = asint(asfloat(r0.xzw) * asfloat(r1.yzw));
	r0.w = asint(-(Exposures.x) + Exposures.y);
	r0.w = asint(r2.x * asfloat(r0.w) + Exposures.x);
	r0.xyz = asint(asfloat(r0.www) * asfloat(r0.xyz));
	r0.w = asint(dot(asfloat(r0.xyz), float3(0.212500006, 0.715399981, 0.0720999986)));
	r1.y = asint(asfloat(r1.x) * asfloat(r0.w));
	r1.z = asint(BurnoutLimit * BurnoutLimit);
	r1.z = asint(asfloat(r1.y) / asfloat(r1.z));
	r1.z = asint(asfloat(r1.z) + 1);
	r1.y = asint(asfloat(r1.z) * asfloat(r1.y));
	r0.w = asint(asfloat(r0.w) * asfloat(r1.x) + 1);
	r0.w = asint(asfloat(r1.y) / asfloat(r0.w));
	r0.xyz = asint(asfloat(r0.www) * asfloat(r0.xyz));
	r0.w = asint(saturate(dot(asfloat(r0.xyz), float3(0.212500006, 0.715399981, 0.0720999986))));
	r0.w = asint(asfloat(r0.w) + 0.0000100999996);
	r1.x = asint(-(deSatContrastGamma.z) + deSatContrastGammaIFX.z);
	r1.x = asint(r2.y * asfloat(r1.x) + deSatContrastGamma.z);
	r1.x = asint(asfloat(r1.x) + -0.999989986);
	r0.w = asint(log2(asfloat(r0.w)));
	r0.w = asint(asfloat(r0.w) * asfloat(r1.x));
	r0.w = asint(exp2(asfloat(r0.w)));
	r0.w = asint(min(asfloat(r0.w), 65000));
	r0.xyz = asint(asfloat(r0.www) * asfloat(r0.xyz));
	r0.xyz = asint(asfloat(r0.xyz) * BrightnessSetting.xxx + BrightnessSetting.yyy);
	r1.xyz = asint(saturate(asfloat(r0.xyz)));
	o.w = dot(asfloat(r1.xyz), float3(0.298999995, 0.587000012, 0.114000000));
	o.xyz = asfloat(r0.xyz);

	return o;
}
