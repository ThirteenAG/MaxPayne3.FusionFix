SamplerState AdapLumSampler : register(s1);
SamplerState BlurSampler : register(s7);
SamplerState BloomSampler : register(s10);
SamplerState RadialBlurSampler : register(s14);
Texture2D AdapLumSampler_tex : register(t1);
Texture2DMS<float> gbufferTextureDepth : register(t3);
Texture2DMS<float4> PostFxTexture0a : register(t6);
Texture2D BlurSampler_tex : register(t7);
Texture2DMS<uint4> StencilCopyTexture : register(t8);
Texture2DMS<float4> PostFxDOFTexture : register(t9);
Texture2D BloomSampler_tex : register(t10);
Texture2D RadialBlurSampler_tex : register(t14);

struct PS_IN
{
	float4 sv_position : SV_Position;
	float2 texcoord : TEXCOORD;
	float2 texcoord1 : TEXCOORD1;
	float2 texcoord2 : TEXCOORD2;
};

float4 main(PS_IN i) : SV_Target
{
	float4 o;

	int4 r0;
	int4 r1;
	int4 r2;
	int4 r3;
	int3 r4;
	float3 r5;
	float3 dimensions0;
	gbufferTextureDepth.GetDimensions(dimensions0.x, dimensions0.y, dimensions0.z);
	r0.xy = asint(dimensions0.xy);
	r0.xy = asint(asfloat(r0.xy) * i.texcoord.xy);
	r0.xy = (int2)asfloat(r0.xy);
	r0.zw = int2(0, 0);
	r0.x = asint(gbufferTextureDepth.Load(r0.xy, 0).x);
	r0.y = asint(-(dofProj.x) + dofProj.y);
	r0.y = asint(dofProj.y / asfloat(r0.y));
	r0.z = asint(asfloat(r0.y) * -(dofProj.x));
	r0.x = asint(-(asfloat(r0.y)) + asfloat(r0.x));
	r0.x = asint(asfloat(r0.z) / asfloat(r0.x));
	float3 dimensions1;
	PostFxTexture0a.GetDimensions(dimensions1.x, dimensions1.y, dimensions1.z);
	r0.yz = asint(dimensions1.xy);
	r0.yz = asint(asfloat(r0.yz) * i.texcoord.xy);
	r1.xy = (int2)asfloat(r0.yz);
	r1.zw = int2(0, 0);
	r0.yzw = asint(PostFxTexture0a.Load(r1.xy, 0).xyz);
	r1.xyz = asint(PostFxTexture0a.Load(r1.xy, 1).xyz);
	r0.yzw = asint(asfloat(r0.yzw) + asfloat(r1.xyz));
	r0.yzw = asint(asfloat(r0.yzw) * float3(0.5, 0.5, 0.5));
	r1.x = (radialBlurScale != 1) ? -1 : 0;
	if (r1.x != 0) {
		r1.xy = asint(i.texcoord.xy + radialBlurTextureStep.xy);
		r1.xyz = asint(RadialBlurSampler_tex.Sample(RadialBlurSampler, asfloat(r1.xy)).xyz);
		r0.yzw = asint(asfloat(r0.yzw) * radialBlurScale + asfloat(r1.xyz));
	}
	r1.x = (0 != blurIntensity) ? -1 : 0;
	if (r1.x != 0) {
		r1.xyz = asint(BlurSampler_tex.Sample(BlurSampler, i.texcoord.xy).xyz);
		r1.xyz = asint(-(asfloat(r0.yzw)) + asfloat(r1.xyz));
		r0.yzw = asint(blurIntensity * asfloat(r1.xyz) + asfloat(r0.yzw));
	}
	r1.xyz = asint(i.texcoord.yxy * float3(2, 2, 2) + float3(-1, -1, -1));
	r1.w = asint(asfloat(r1.y) * dofProj.z);
	r1.x = asint(-(asfloat(r1.x)) * dofProj.w);
	r1.xw = asint(asfloat(r0.xx) * asfloat(r1.xw));
	r2.xyz = asint(asfloat(r1.xxx) * motionBlurMatrix[1].xyz);
	r2.xyz = asint(asfloat(r1.www) * motionBlurMatrix[0].xyz + asfloat(r2.xyz));
	r2.xyz = asint(-(asfloat(r0.xxx)) * motionBlurMatrix[2].xyz + asfloat(r2.xyz));
	r2.xyz = asint(asfloat(r2.xyz) + motionBlurMatrix[3].xyz);
	r0.x = asint(-(asfloat(r2.z)) * dofProj.z);
	r3.x = asint(asfloat(r2.x) / asfloat(r0.x));
	r0.x = asint(asfloat(r2.z) * dofProj.w);
	r3.y = asint(asfloat(r2.y) / asfloat(r0.x));
	r1.xy = asint(-(asfloat(r1.yz)) + asfloat(r3.xy));
	r1.xy = asint(asfloat(r1.xy) * DirectionalMotionBlurLength);
	r1.zw = asint(asfloat(r1.xy) * float2(0.166666672, 0.166666672));
	float3 dimensions2;
	PostFxDOFTexture.GetDimensions(dimensions2.x, dimensions2.y, dimensions2.z);
	r2.xy = asint(dimensions2.xy);
	r2.zw = asint(asfloat(r2.xy) * i.texcoord.xy);
	r3.xy = (int2)asfloat(r2.zw);
	r3.zw = int2(0, 0);
	r0.x = StencilCopyTexture.Load(r3.xy, 0).y;
	r0.x = (128 >= (uint)r0.x) ? -1 : 0;
	r0.x = r0.x & 1065353216;
	r3.zw = int2(0, 0);
	r4 = r0.yzw;
	r2.z = 1;
	while (true) {
		r2.w = (r2.z >= 6) ? -1 : 0;
		if (r2.w != 0) break;
		r2.w = asint((float)r2.z);
		r5.xy = asfloat(r1.zw) * asfloat(r2.ww) + i.texcoord.xy;
		r5.xy = asfloat(r2.xy) * r5.xy;
		r3.xy = (int2)r5.xy;
		r5 = PostFxDOFTexture.Load(r3.xy, 0).xyz;
		r4 = asint(asfloat(r4.xyz) + r5.xyz);
		r2.z = r2.z + 1;
	}
	r1.xy = asint(asfloat(r1.xy) * globalScreenSize.xy);
	r1.x = asint(dot(asfloat(r1.xy), asfloat(r1.xy)));
	r1.x = asint(sqrt(asfloat(r1.x)));
	r1.x = asint(asfloat(r1.x) * 0.5);
	r1.x = asint(min(asfloat(r1.x), 1));
	r0.x = asint(asfloat(r0.x) * asfloat(r1.x));
	// Normalize the center sample plus five motion-blur samples.
	r1.xyz = asint(asfloat(r4.xyz) * float3(0.166666667, 0.166666667, 0.166666667) + -(asfloat(r0.yzw)));
	r0.xyz = asint(asfloat(r0.xxx) * asfloat(r1.xyz) + asfloat(r0.yzw));
	r0.w = asint(AdapLumSampler_tex.Sample(AdapLumSampler, float2(0, 0)).x);
	r0.w = asint(asfloat(r0.w) + 0.000000999999997);
	r0.w = asint(ToneMapParams.y / asfloat(r0.w));
	r1.xyz = asint(BloomSampler_tex.Sample(BloomSampler, i.texcoord.xy).xyz);
	r1.xyz = asint(asfloat(r1.xyz) * ToneMapParams.zzz);
	r0.xyz = asint(asfloat(r1.xyz) * float3(0.25, 0.25, 0.25) + asfloat(r0.xyz));
	r1.xyz = asint(i.texcoord.yyy * ColorCorrectBottomOffset.xyz + ColorCorrectTopAndPedReflectScale.xyz);
	r0.xyz = asint(asfloat(r0.xyz) * asfloat(r1.xyz));
	r0.xyz = asint(asfloat(r0.xyz) * Exposures.xxx);
	r1.x = asint(dot(asfloat(r0.xyz), float3(0.212500006, 0.715399981, 0.0720999986)));
	r1.y = asint(asfloat(r0.w) * asfloat(r1.x));
	r1.z = asint(BurnoutLimit * BurnoutLimit);
	r1.z = asint(asfloat(r1.y) / asfloat(r1.z));
	r1.z = asint(asfloat(r1.z) + 1);
	r1.y = asint(asfloat(r1.z) * asfloat(r1.y));
	r0.w = asint(asfloat(r1.x) * asfloat(r0.w) + 1);
	r0.w = asint(asfloat(r1.y) / asfloat(r0.w));
	r0.xyz = asint(asfloat(r0.www) * asfloat(r0.xyz));
	r0.w = asint(saturate(dot(asfloat(r0.xyz), float3(0.212500006, 0.715399981, 0.0720999986))));
	r0.w = asint(asfloat(r0.w) + 0.0000100999996);
	r1.x = asint(deSatContrastGamma.z + -0.999989986);
	r0.w = asint(log2(asfloat(r0.w)));
	r0.w = asint(asfloat(r0.w) * asfloat(r1.x));
	r0.w = asint(exp2(asfloat(r0.w)));
	r0.w = asint(min(asfloat(r0.w), 65000));
	r0.xyz = asint(asfloat(r0.www) * asfloat(r0.xyz));
	r0.xyz = asint(asfloat(r0.xyz) * BrightnessSetting.xxx + BrightnessSetting.yyy);
	r1.xyz = asint(saturate(asfloat(r0.xyz)));
	o.w = dot(asfloat(r1.xyz), float3(0.298999995, 0.587000012, 0.114000000));
	o.xyz = asfloat(r0.xyz);

	return o;
}
