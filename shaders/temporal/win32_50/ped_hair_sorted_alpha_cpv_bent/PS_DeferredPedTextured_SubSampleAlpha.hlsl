	r5.xyz = BumpSampler_tex.Sample(BumpSampler, i.texcoord.xy).xyw;
	r3.w = asint(-(r5.z) + 1);
	r3.w = (asfloat(r3.w) < r5.x) ? -1 : 0;
	r3.w = r3.w & 1065353216;
	r5.xw = -(r5.zy) + r5.xy;
