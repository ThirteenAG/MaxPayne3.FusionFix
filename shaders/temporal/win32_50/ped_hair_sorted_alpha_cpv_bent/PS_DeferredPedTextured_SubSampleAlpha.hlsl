	r1.xyz = r1.xyz * asfloat(r3.yyy) + r5.xyz;
	r3.w = asint(i.texcoord2.x * 1.5);
	o.sv_target.xyz = r1.xyz * asfloat(r3.www);
	r1.xyz = r6.yyy * i.texcoord5.xyz;
