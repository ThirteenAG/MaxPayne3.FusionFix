	r11 = r3.x * r6;
	r8 = r8 * r10;
	r9 = r9 * r10;
	r10 = r8 * r3.y + r11;
	r10 = r9 * r3.z + r10;
	r1.w = asint(saturate(r3.z * -0.5 + 0.5));
	r3 = saturate(r7 * r10);
	r7 = r6 * -(gLightDirX);
	r6 = r4.x * r6;
	r6 = r4.y * r8 + r6;
	r7 = r8 * -(gLightDirY) + r7;
	r7 = r9 * -(gLightDirZ) + r7;
