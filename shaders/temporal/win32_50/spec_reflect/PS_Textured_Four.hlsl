	r7.z = dot(gLightColB, r6);
	r5 = r5.xyz * gDirectionalLight.www + r7.xyz;
	r6.xyz = -(gLightAmbient0.xyz) + gLightAmbient1.xyz;
	r6.xyz = asfloat(r1.www) * r6.xyz + gLightAmbient0.xyz;
