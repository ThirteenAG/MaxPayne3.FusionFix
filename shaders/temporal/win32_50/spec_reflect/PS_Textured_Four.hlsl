	r1.w = asint(asfloat(r2.x) * asfloat(r2.x));
	r1.w = asint(asfloat(r1.w) * asfloat(r1.w));
	r1.w = asint(asfloat(r1.w) * asfloat(r2.x));
	r2.x = asint(-(fresnelRolloff) + 1);
	r1.w = asint(fresnelRolloff * asfloat(r1.w) + asfloat(r2.x));
	r2.x = asint(dot(r4.xyz, r4.xyz));
	r2.x = asint(rsqrt(asfloat(r2.x)));
