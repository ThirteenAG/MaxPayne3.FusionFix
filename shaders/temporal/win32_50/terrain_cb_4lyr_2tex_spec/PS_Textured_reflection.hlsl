	r0.w = asint(dot(gLightAmbientDir1.xyz, asfloat(r0.xyz)));
	r0.w = asint(saturate(asfloat(r0.w) + gLightAmbientDir0.w));
	r4 = asfloat(r0.www) * gLightAmbient1.xyz;
	r0.w = asint(dot(gLightAmbientDir0.xyz, asfloat(r0.xyz)));
	r0.x = asint(dot(asfloat(r0.xyz), -(gDirectionalLight.xyz)));
	r0.x = asint(asfloat(r0.x) + -0.25);
	r0.x = asint(saturate(asfloat(r0.x) * 1.33333337));
	r0.xyz = asint(asfloat(r0.xxx) * gDirectionalColour.xyz);
	r0.w = asint(saturate(asfloat(r0.w) + gLightAmbientDir0.w));
	r4 = asfloat(r0.www) * gLightAmbient0.xyz + r4.xyz;
	r0.xyz = asint(r4.xyz * i.texcoord3.xxx + asfloat(r0.xyz));
	r4 = TextureSampler_layer1_tex.SampleBias(TextureSampler_layer1, i.texcoord.zw, -1.29999995).xyz;
	r2.xzw = r2.www * r4.xyz;
	r4 = TextureSampler_layer0_tex.SampleBias(TextureSampler_layer0, i.texcoord.xy, -1.29999995).xyz;
	r2.xyz = r4.xyz * r2.yyy + r2.xzw;
	r4 = TextureSampler_layer2_tex.SampleBias(TextureSampler_layer2, i.texcoord.zw, -1.29999995).xyz;
	r1.xyw = asint(r4.xyz * asfloat(r1.www) + r2.xyz);
	r2.xyz = TextureSampler_layer3_tex.SampleBias(TextureSampler_layer3, i.texcoord.zw, -1.29999995).xyz;
	r1.xyz = asint(r2.xyz * asfloat(r1.zzz) + asfloat(r1.xyw));
	r0.xyz = asint(asfloat(r1.xyz) * asfloat(r0.xyz) + r3.xyz);
	r1.xyz = asint(-(asfloat(r0.xyz)) + globalFogColor.xyz);
	r0.w = asint(i.texcoord2.w + -(globalFogParams.x));
	r1.w = asint(-(globalFogParams.x) + globalFogParams.y);
	r0.w = asint(saturate(asfloat(r0.w) / asfloat(r1.w)));
	r0.xyz = asint(asfloat(r0.www) * asfloat(r1.xyz) + asfloat(r0.xyz));
	r0.w = asint(dot(asfloat(r0.xyz), float3(0.212500006, 0.715399981, 0.0720999986)));
	r0.xyz = asint(-(asfloat(r0.www)) + asfloat(r0.xyz));
	r1.x = asint(gAdrenoFXVars.x * deSatContrastGamma.x);
	r0.xyz = asint(asfloat(r1.xxx) * asfloat(r0.xyz) + asfloat(r0.www));
	r0.xyz = asint(saturate(asfloat(r0.xyz) * float3(0.0625, 0.0625, 0.0625)));
	o.xyz = sqrt(asfloat(r0.xyz));
	r0.x = asint(globalScalars.x * globalScalars.x);
	o.w = asfloat(r0.x) * i.texcoord3.w;

	return o;
}
