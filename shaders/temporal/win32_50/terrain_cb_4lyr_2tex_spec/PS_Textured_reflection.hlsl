	r2.xz = SpecSampler_layer01_tex.Sample(SpecSampler_layer01, i.texcoord.xy).xy;
	r2.xz = r2.xz * float2(specularFactor, specularColorFactor);
	r1.xy = asint(r2.xz * r2.yy + asfloat(r1.xy));
	r3 = SpecSampler_layer23_tex.Sample(SpecSampler_layer23, i.texcoord.zw);
	r3 = r3 * float4(specularFactor2, specularColorFactor2, specularFactor3, specularColorFactor3);
	r1.xy = asint(r3.xy * asfloat(r1.ww) + asfloat(r1.xy));
	r1.xy = asint(r3.zw * asfloat(r1.zz) + asfloat(r1.xy));
	r1.x = asint(asfloat(r1.x) + 0.00000999999975);
	r0.w = asint(asfloat(r0.w) * asfloat(r1.x));
	r0.w = asint(exp2(asfloat(r0.w)));
	r3.xyz = asfloat(r0.www) * gDirectionalColour.xyz;
