struct PS_IN
{
	float4 sv_position : SV_Position;
	float4 texcoord : TEXCOORD;
	float4 color : COLOR;
	float3 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float4 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord6 : TEXCOORD6;
};

float4 main(PS_IN i) : SV_Target
{
	float4 o;

	int4 r0;
	int4 r1;
	float4 r2;
	float4 r3;
	float3 r4;
	r0.xyz = asint(BumpSampler_layer3_tex.Sample(BumpSampler_layer3, i.texcoord.zw).xyw);
	r0.w = asint(-(asfloat(r0.z)) + 1);
	r0.w = (asfloat(r0.w) < asfloat(r0.x)) ? -1 : 0;
	r0.w = r0.w & 1065353216;
	r1.xy = asint(-(asfloat(r0.zy)) + asfloat(r0.xy));
	r0.xy = asint(asfloat(r0.ww) * asfloat(r1.xy) + asfloat(r0.zy));
	r1.xyz = asint(BumpSampler_layer2_tex.Sample(BumpSampler_layer2, i.texcoord.zw).xyw);
	r0.z = asint(-(asfloat(r1.z)) + 1);
	r0.z = (asfloat(r0.z) < asfloat(r1.x)) ? -1 : 0;
	r0.z = r0.z & 1065353216;
	r1.xw = asint(-(asfloat(r1.zy)) + asfloat(r1.xy));
	r0.zw = asint(asfloat(r0.zz) * asfloat(r1.xw) + asfloat(r1.zy));
	r1.xyz = asint(BumpSampler_layer0_tex.Sample(BumpSampler_layer0, i.texcoord.xy).xyw);
	r1.w = asint(-(asfloat(r1.z)) + 1);
	r1.w = (asfloat(r1.w) < asfloat(r1.x)) ? -1 : 0;
	r1.w = r1.w & 1065353216;
	r2.xy = -(asfloat(r1.zy)) + asfloat(r1.xy);
	r1.xy = asint(asfloat(r1.ww) * r2.xy + asfloat(r1.zy));
	r2.xyz = BumpSampler_layer1_tex.Sample(BumpSampler_layer1, i.texcoord.zw).xyw;
	r1.z = asint(-(r2.z) + 1);
	r1.z = (asfloat(r1.z) < r2.x) ? -1 : 0;
	r1.z = r1.z & 1065353216;
	r2.xw = -(r2.zy) + r2.xy;
	r1.zw = asint(asfloat(r1.zz) * r2.xw + r2.zy);
	r2.xyz = -(i.color.xyz) + float3(1, 1, 1);
	r2.y = r2.y * r2.x;
	r2.w = r2.y * i.color.z;
	r2.y = r2.z * r2.y;
	r1.zw = asint(asfloat(r1.zw) * r2.ww);
	r1.xy = asint(asfloat(r1.xy) * r2.yy + asfloat(r1.zw));
	r1.z = asint(r2.x * i.color.y);
	r1.w = asint(r2.z * asfloat(r1.z));
	r1.z = asint(asfloat(r1.z) * i.color.z);
	r0.zw = asint(asfloat(r0.zw) * asfloat(r1.ww) + asfloat(r1.xy));
	r0.xy = asint(asfloat(r0.xy) * asfloat(r1.zz) + asfloat(r0.zw));
	r0.xy = asint(asfloat(r0.xy) + float2(-0.5, -0.5));
	r0.xy = asint(asfloat(r0.xy) * bumpiness);
	r0.xy = asint(asfloat(r0.xy) + asfloat(r0.xy));
	r0.z = asint(dot(asfloat(r0.xy), asfloat(r0.xy)));
	r0.z = asint(-(asfloat(r0.z)) + 1);
	r0.z = asint(max(asfloat(r0.z), 0));
	r0.z = asint(sqrt(asfloat(r0.z)));
	r3.xyz = asfloat(r0.xxx) * i.texcoord5.xyz;
	r0.xzw = asint(i.texcoord2.xyz * asfloat(r0.zzz) + r3.xyz);
	r0.xyz = asint(asfloat(r0.yyy) * i.texcoord6.xyz + asfloat(r0.xzw));
	r0.xyz = asint(asfloat(r0.xyz) + float3(0.00000999999975, 0.00000999999975, 0.00000999999975));
	r0.w = asint(dot(asfloat(r0.xyz), asfloat(r0.xyz)));
	r0.w = asint(rsqrt(asfloat(r0.w)));
	r0.xyz = asint(asfloat(r0.www) * asfloat(r0.xyz));
	r3.xyz = i.texcoord4.xyz + float3(0.00000999999975, 0.00000999999975, 0.00000999999975);
	r0.w = asint(dot(r3.xyz, r3.xyz));
	r0.w = asint(rsqrt(asfloat(r0.w)));
	r3.xyz = asfloat(r0.www) * r3.xyz;
	r0.w = asint(dot(r3.xyz, asfloat(r0.xyz)));
	r0.w = asint(asfloat(r0.w) + asfloat(r0.w));
	r3.xyz = asfloat(r0.xyz) * -(asfloat(r0.www)) + r3.xyz;
	r0.w = asint(saturate(dot(-(gDirectionalLight.xyz), r3.xyz)));
	r0.w = asint(asfloat(r0.w) + 0.00000999999975);
	r0.w = asint(log2(asfloat(r0.w)));
	r1.xy = asint(SpecSampler_layer01_tex.Sample(SpecSampler_layer01, i.texcoord.zw).zw);
	r1.xy = asint(asfloat(r1.xy) * float2(specularFactor1, specularColorFactor1));
