	r2.w = asint(-(asfloat(r1.z)) + 1);
	r1.x = asint(asfloat(r1.z) * asfloat(r1.x) + asfloat(r2.w));
	r3 = asfloat(r1.xxx) * r3.xyz;
	r1.x = asint(-(normReflectivePower) + goldReflectivePower);
	r1.x = asint(goldFactor * asfloat(r1.x) + normReflectivePower);
	r3 = asfloat(r1.xxx) * r3.xyz;
	r4 = SpecSampler_tex.Sample(SpecSampler, i.texcoord.xy);
	r5 = -(r4) + float4(1, 1, 1, 1);
	r4 = goldFactor * r5 + r4;
	r1.x = asint(dot(r4.xyz, specMapReflectMask));
	r3 = asfloat(r1.xxx) * r3.xyz;
	r1.x = asint(-(globalScalars.w) + 1);
	r1.x = asint(goldFactor * asfloat(r1.x) + globalScalars.w);
	r3 = asfloat(r1.xxx) * r3.xyz;
	r5 = DiffuseSampler_tex.Sample(DiffuseSampler, i.texcoord.xy);
	r1.x = asint(r5.w * i.color.w);
	r1.z = asint(max(asfloat(r1.x), 0.00999999978));
	r6.w = asfloat(r1.x) * globalScalars.x;
	r1.x = asint(1 / asfloat(r1.z));
	r3 = asfloat(r1.xxx) * r3.xyz;
	r1.xzw = asint(asfloat(r1.www) * r3.xyz);
	r2.w = asint(dot(r4, specMapExpMask));
