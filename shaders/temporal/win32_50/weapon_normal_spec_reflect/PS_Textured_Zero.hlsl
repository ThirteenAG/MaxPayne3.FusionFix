	r2.xyz = asint(asfloat(r0.xyz) * asfloat(r1.www) + asfloat(r2.xyz));
	r1.w = asint(dot(asfloat(r2.xyz), float3(0.333333343, 0.333333343, 0.333333343)));
	r1.w = asint(asfloat(r1.w) + 0.0149999997);
	r3 = i.texcoord3.xyz + float3(0.00000999999975, 0.00000999999975, 0.00000999999975);
	r2.w = asint(dot(r3.xyz, r3.xyz));
	r2.w = asint(rsqrt(asfloat(r2.w)));
	r3 = asfloat(r2.www) * r3.xyz;
	r2.w = asint(dot(-(r3.xyz), asfloat(r1.xyz)));
	r2.w = asint(asfloat(r2.w) + asfloat(r2.w));
	r4.xyz = asfloat(r1.xyz) * -(asfloat(r2.www)) + -(r3.xyz);
	r1.x = asint(saturate(dot(r3.xyz, asfloat(r1.xyz))));
	r1.x = asint(-(asfloat(r1.x)) + 1.00001001);
	r3 = r4.xyz + float3(0.00000999999975, 0.00000999999975, 0.00000999999975);
	r1.y = asint(saturate(dot(-(gDirectionalLight.xyz), r4.xyz)));
	r1.y = asint(asfloat(r1.y) + 0.00000999999975);
	r1.y = asint(log2(asfloat(r1.y)));
	r1.z = asint(dot(r3.xyz, r3.xyz));
	r1.z = asint(rsqrt(asfloat(r1.z)));
	r3.xy = r3.xz * asfloat(r1.zz) + float2(1, 1);
	r3.xy = r3.xy * float2(-0.5, -0.5);
	r3 = EnvironmentSampler_tex.Sample(EnvironmentSampler, r3.xy).xyz;
	r4.xyz = r3.xyz * goldReflectColorOverlay.xyz + -(r3.xyz);
	r3 = goldFactor * r4.xyz + r3.xyz;
	r1.z = asint(asfloat(r1.x) * asfloat(r1.x));
	r1.z = asint(asfloat(r1.z) * asfloat(r1.z));
	r1.x = asint(asfloat(r1.z) * asfloat(r1.x));
	r1.z = asint(-(normFresnelRolloff) + goldFresnelRolloff);
